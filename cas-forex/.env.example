# CAS Forex configuration
# Copy this to .env and fill in your keys

# Nixtla TimeGPT (ai forecast model)
CAS_FOREX_TIMEGPT_API_KEY=

# OANDA (real-time forex data)
CAS_FOREX_OANDA_API_KEY=
CAS_FOREX_OANDA_ACCOUNT_ID=
CAS_FOREX_OANDA_ENVIRONMENT=practice
CAS_FOREX_MARKET_DATA_PROVIDER=YAHOO

# AI Operator model routing
# Direct DeepSeek: Flash handles continuous reasoning; Pro is selected for
# compound scale-ins and other configured escalation request kinds.
CAS_FOREX_AI_OPERATOR_DEEPSEEK_ENABLED=true
CAS_FOREX_AI_OPERATOR_DEEPSEEK_TRANSPORT=direct
CAS_FOREX_AI_OPERATOR_DEEPSEEK_API_KEY=
CAS_FOREX_AI_OPERATOR_DEEPSEEK_BASE_URL=https://api.deepseek.com
CAS_FOREX_AI_OPERATOR_FLASH_MODEL=deepseek-v4-flash
CAS_FOREX_AI_OPERATOR_PRO_MODEL=deepseek-v4-pro
# Alternative: set transport=ollama_cloud after `ollama signin`; CAS will use
# deepseek-v4-flash:cloud and deepseek-v4-pro:cloud through the local daemon.
CAS_FOREX_AI_OPERATOR_DEEPSEEK_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional independent large-model backup after DeepSeek. This uses the
# signed-in Ollama Cloud rail and does not download the 31B model locally.
CAS_FOREX_AI_OPERATOR_GEMMA_BACKUP_ENABLED=false
CAS_FOREX_AI_OPERATOR_GEMMA_BACKUP_TRANSPORT=ollama_cloud
CAS_FOREX_AI_OPERATOR_GEMMA_BACKUP_MODEL=gemma4:31b-cloud
CAS_FOREX_AI_OPERATOR_GEMMA_BACKUP_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Hugo's Way / MT5 (live trading)
CAS_FOREX_MT5_LOGIN=0
CAS_FOREX_MT5_PASSWORD=
CAS_FOREX_MT5_SERVER=
CAS_FOREX_LIVE_MODE=false
CAS_FOREX_PAPER_TRADING=true

# Risk (change only if you know what you're doing)
CAS_FOREX_MAX_DAILY_DD_PCT=2.0
CAS_FOREX_MAX_WEEKLY_DD_PCT=5.0
CAS_FOREX_MAX_POSITION_LOTS=0.1
