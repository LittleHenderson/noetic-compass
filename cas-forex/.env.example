# CAS Forex configuration
# Copy this to .env and fill in your keys

# Nixtla TimeGPT (ai forecast model)
CAS_FOREX_TIMEGPT_API_KEY=

# OANDA (real-time forex data)
CAS_FOREX_OANDA_API_KEY=
CAS_FOREX_OANDA_ACCOUNT_ID=
CAS_FOREX_OANDA_ENVIRONMENT=practice
CAS_FOREX_MARKET_DATA_PROVIDER=YAHOO

# Hugo's Way / MT5 (live trading)
CAS_FOREX_MT5_LOGIN=0
CAS_FOREX_MT5_PASSWORD=
CAS_FOREX_MT5_SERVER=
CAS_FOREX_LIVE_MODE=false
CAS_FOREX_PAPER_TRADING=true

# Risk (change only if you know what you're doing)
CAS_FOREX_MAX_DAILY_DD_PCT=2.0
CAS_FOREX_MAX_WEEKLY_DD_PCT=5.0
CAS_FOREX_MAX_POSITION_LOTS=0.1
