# CAS Forex hosted external monitoring template
#
# Fill these in only in your deployment environment, secret manager, or local
# runtime override. Do not commit real values to the repo.

# Off-machine uptime / heartbeat monitor URL
CAS_FOREX_EXTERNAL_UPTIME_MONITOR_URL=https://healthchecks.example/ping/cas-forex-runtime

# Hosted error-tracking DSN
CAS_FOREX_ERROR_TRACKING_DSN=https://public:private@sentry.example/42

# Off-screen critical alert destination
CAS_FOREX_ALERT_WEBHOOK_URL=https://hooks.example/services/cas-forex-critical
