# Copy to ui/android/keystore.properties and fill with your local signing key.
# keystore.properties is ignored by git; do not commit real signing secrets.
#
# Generate a local release key, for example:
# keytool -genkeypair -v -keystore cas-forex-release.jks -alias cas-forex \
#   -keyalg RSA -keysize 2048 -validity 10000

storeFile=cas-forex-release.jks
storePassword=change-me
keyAlias=cas-forex
keyPassword=change-me
