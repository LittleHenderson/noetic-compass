{
  "name": "cas-forex-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "mobile:pwa": "npm run build",
    "mobile:preview": "vite preview --host 0.0.0.0 --port 4173",
    "mobile:readiness": "cd .. && python scripts/run_mobile_release_readiness.py",
    "mobile:stack": "cd .. && python scripts/run_mobile_stack_readiness.py",
    "mobile:verify-session": "cd .. && python scripts/run_phone_verification_session.py",
    "mobile:proof-session": "cd .. && python scripts/run_mobile_proof_session.py",
    "mobile:verification-plan": "cd .. && python scripts/run_mobile_verification_plan.py",
    "mobile:finish": "cd .. && python scripts/run_mobile_final_verification.py",
    "mobile:phone-proof": "cd .. && python scripts/watch_mobile_phone_proof.py",
    "mobile:docker-check": "cd .. && python scripts/run_docker_engine_check.py",
    "mobile:docker-install": "cd .. && python scripts/install_docker_desktop.py",
    "mobile:docker-install-elevated": "cd .. && powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\install_docker_desktop_elevated.ps1",
    "mobile:apk:sync": "npm run build && npx cap sync android",
    "mobile:apk:debug": "npm run build && npx cap sync android && cd .. && python scripts/run_android_gradle.py assembleDebug",
    "mobile:apk:build-all": "cd .. && python scripts/build_android_apks.py",
    "mobile:apk:devices": "cd .. && python scripts/install_android_debug_apk.py --list-devices",
    "mobile:apk:install": "cd .. && python scripts/install_android_debug_apk.py --exit-code-on-failure",
    "mobile:apk:pair": "cd .. && python scripts/install_android_debug_apk.py --launch-only --exit-code-on-failure",
    "mobile:apk:install-pair": "cd .. && python scripts/install_android_debug_apk.py --launch-native-pairing --exit-code-on-failure",
    "mobile:apk:wait-install-pair": "cd .. && python scripts/install_android_debug_apk.py --launch-native-pairing --wait-for-device --wait-timeout-seconds 600 --exit-code-on-failure",
    "mobile:apk:setup-release-signing": "cd .. && python scripts/setup_android_release_signing.py",
    "mobile:apk:release": "npm run build && npx cap sync android && cd .. && python scripts/run_android_gradle.py assembleRelease"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.12",
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  }
}
