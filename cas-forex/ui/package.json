{
  "name": "cas-forex-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "mobile:pwa": "npm run build",
    "mobile:preview": "vite preview --host 0.0.0.0 --port 5174",
    "mobile:apk:sync": "npm run build && npx cap sync android",
    "mobile:apk:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.12",
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  }
}
