# Secrets — never commit
.env

# Python caches / build
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.pydeps/
.pydeps-win312/
.mt5deps/

# Local scratch / generated artifacts
tmppcba-pytest/
tmp_output.txt
evidence_runs/
runtime/
uvicorn-*.log

# External market/calendar data (downloaded or user-supplied; NEVER committed —
# big, and not ours to redistribute). Forex Factory calendar + HistData M1 CSVs.
data/external/
ui/node_modules/
ui/dist/
*.tsbuildinfo

# Stray Windows shell/cache junk (e.g. unexpanded %SystemDrive% creating fake trees)
ui/%SystemDrive%/
**/%SystemDrive%/
**/ProgramData/Microsoft/Windows/Caches/

# Capacitor native projects. Keep Android trackable so the APK wrapper is a
# real project artifact; ui/android/.gitignore excludes build outputs, copied
# web assets, local SDK paths, and signing secrets.
ui/ios/

# Local Claude Code permission state (machine-specific)
.claude/settings.local.json

# Spec-sheet builder scratch output (15k+ files, regenerated on demand)
tmp/
