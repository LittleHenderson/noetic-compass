{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.example/schemas/board-change-v2/corpus-v1",
  "title": "CAS board-change v2 canonical corpus conversation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "conversation_id", "stratum", "family",
    "seed_prompt_sha256", "generator", "turns"
  ],
  "properties": {
    "schema_version": {"const": "cas.board_change_v2.corpus.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "pattern": "^BCV2-[NS]-[0-9]{3}$"},
    "stratum": {"enum": ["N", "S"]},
    "family": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6"]},
    "seed_prompt_sha256": {"$ref": "#/$defs/sha256"},
    "generator": {"type": "object"},
    "turns": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/turn"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_index", "user_text", "user_text_sha256", "assistant_text",
        "assistant_text_sha256", "operation_id", "attempt_record_sha256"
      ],
      "properties": {
        "turn_index": {"type": "integer", "minimum": 0, "maximum": 9},
        "user_text": {"type": "string", "minLength": 1},
        "user_text_sha256": {"$ref": "#/$defs/sha256"},
        "assistant_text": {"type": "string", "minLength": 1},
        "assistant_text_sha256": {"$ref": "#/$defs/sha256"},
        "operation_id": {"type": "string", "minLength": 1},
        "attempt_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
