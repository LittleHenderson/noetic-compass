{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.example/schemas/board-change-v2/provider-attempt-v1",
  "title": "CAS board-change v2 immutable provider-attempt evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sequence", "previous_record_sha256", "record_sha256", "attempt_id",
    "run_id", "operation_id", "operation_kind", "task", "repair_round", "attempt_no",
    "retry_of_attempt_id", "disposition", "protocol_lock_sha256", "prompt_plan_sha256",
    "frozen_bundle_sha256", "corpus_sha256", "cost_evidence", "label_contract",
    "provider_evidence", "admission"
  ],
  "properties": {
    "schema_version": {"const": "cas.board_change_v2.provider_attempt.v1"},
    "sequence": {"type": "integer", "minimum": 0},
    "previous_record_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "operation_kind": {"enum": ["generation", "label"]},
    "task": {"oneOf": [{"type": "null"}, {"enum": ["board", "change", "user"]}]},
    "repair_round": {"type": "integer", "minimum": 0, "maximum": 2},
    "attempt_no": {"type": "integer", "minimum": 1},
    "retry_of_attempt_id": {"type": ["string", "null"]},
    "disposition": {"enum": ["accepted", "retryable", "terminal_failure"]},
    "protocol_lock_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_plan_sha256": {"$ref": "#/$defs/sha256"},
    "frozen_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "cost_evidence": {"$ref": "#/$defs/costEvidence"},
    "label_contract": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/labelContract"}]},
    "provider_evidence": {"$ref": "#/$defs/providerEvidence"},
    "admission": {"$ref": "#/$defs/admission"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "money": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,8})?$"},
    "costEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "currency", "usage_receipt_status", "pricing_receipt_status", "input_tokens", "output_tokens", "input_usd_per_million_tokens", "output_usd_per_million_tokens", "derived_cost_usd"],
      "properties": {
        "classification": {"const": "MOCK_DERIVED_NOT_BILLING_EVIDENCE"},
        "currency": {"const": "USD"},
        "usage_receipt_status": {"const": "MOCK_UNAUTHENTICATED"},
        "pricing_receipt_status": {"const": "FROZEN_MOCK_RATE_TABLE_NOT_PROVIDER_RECEIPT"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "input_usd_per_million_tokens": {"$ref": "#/$defs/money"},
        "output_usd_per_million_tokens": {"$ref": "#/$defs/money"},
        "derived_cost_usd": {"$ref": "#/$defs/money"}
      }
    },
    "evidenceValue": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {"status": {"const": "present"}, "value": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "unavailable"}, "reason": {"type": "string", "minLength": 1}}}
      ]
    },
    "artifact": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "relative_path", "sha256", "bytes"], "properties": {"status": {"const": "present"}, "relative_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "unavailable"}, "reason": {"type": "string", "minLength": 1}}}
      ]
    },
    "usage": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "input_tokens", "output_tokens", "total_tokens"], "properties": {"status": {"const": "present"}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "unavailable"}, "reason": {"type": "string", "minLength": 1}}}
      ]
    },
    "responseExtraction": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "kind", "json_pointer", "extracted_text_sha256", "parsed_json_sha256"],
          "properties": {
            "status": {"const": "present"},
            "kind": {"enum": ["assistant_text", "label_json"]},
            "json_pointer": {"type": "string", "pattern": "^/"},
            "extracted_text_sha256": {"$ref": "#/$defs/sha256"},
            "parsed_json_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {"status": {"const": "unavailable"}, "reason": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "labelContract": {
      "type": "object", "additionalProperties": false,
      "required": ["alias_map", "alias_map_sha256", "accepted_labels_sha256"],
      "properties": {
        "alias_map": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["alias_id", "item_id"],
            "properties": {
              "alias_id": {"type": "integer", "minimum": 1000, "maximum": 9999},
              "item_id": {"type": "string", "minLength": 1}
            }
          }
        },
        "alias_map_sha256": {"$ref": "#/$defs/sha256"},
        "accepted_labels_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "admission": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "authorization_sha256", "authorization_event_sha256", "phase_event_sha256", "phase_started_at_utc", "admitted_at_utc", "frozen_bundle_sha256", "execution_class"],
      "properties": {
        "status": {"const": "MOCK_ONLY_NEVER_PRODUCTION"},
        "authorization_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_event_sha256": {"$ref": "#/$defs/sha256"},
        "phase_event_sha256": {"$ref": "#/$defs/sha256"},
        "phase_started_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "admitted_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "frozen_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "execution_class": {"const": "MOCK_TEST_ONLY"}
      }
    },
    "providerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "endpoint_origin", "requested_model", "resolved_response_model",
        "provider_request_id", "provider_created_at_utc", "request_artifact",
        "response_artifact", "response_headers_artifact", "sdk_name", "sdk_version",
        "started_at_utc", "finished_at_utc", "http_status", "finish_reason", "usage", "error",
        "response_extraction", "transport_receipt"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "endpoint_origin": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+/?$"},
        "requested_model": {"type": "string", "minLength": 1},
        "resolved_response_model": {"$ref": "#/$defs/evidenceValue"},
        "provider_request_id": {"$ref": "#/$defs/evidenceValue"},
        "provider_created_at_utc": {"$ref": "#/$defs/evidenceValue"},
        "request_artifact": {"$ref": "#/$defs/artifact"},
        "response_artifact": {"$ref": "#/$defs/artifact"},
        "response_headers_artifact": {"$ref": "#/$defs/artifact"},
        "sdk_name": {"type": "string", "minLength": 1},
        "sdk_version": {"type": "string", "minLength": 1},
        "started_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "finished_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "finish_reason": {"$ref": "#/$defs/evidenceValue"},
        "usage": {"$ref": "#/$defs/usage"},
        "error": {"$ref": "#/$defs/evidenceValue"},
        "response_extraction": {"$ref": "#/$defs/responseExtraction"},
        "transport_receipt": {
          "type": "object", "additionalProperties": false,
          "required": ["classification", "method", "endpoint_origin", "request_path", "request_body_sha256", "response_body_sha256", "response_headers_sha256"],
          "properties": {
            "classification": {"enum": ["MOCK_CAPTURE_ONLY_NEVER_PRODUCTION", "AUTHENTICATED_PROVIDER_RECEIPT"]},
            "method": {"const": "POST"},
            "endpoint_origin": {"enum": ["https://generativelanguage.googleapis.com", "https://api.deepseek.com", "https://dashscope-intl.aliyuncs.com", "https://open.bigmodel.cn"]},
            "request_path": {"enum": ["/v1beta/openai/chat/completions", "/chat/completions", "/compatible-mode/v1/chat/completions", "/api/paas/v4/chat/completions"]},
            "request_body_sha256": {"$ref": "#/$defs/sha256"},
            "response_body_sha256": {"$ref": "#/$defs/sha256"},
            "response_headers_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
