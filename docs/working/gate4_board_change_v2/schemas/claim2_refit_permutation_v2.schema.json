{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.example/schemas/board-change-v2/claim2-refit-permutation-v1",
  "title": "CAS board-change v2 Claim-2 refit permutation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "claim_status", "algorithm", "learner_id", "learner_contract", "trials", "seed",
    "learner_invocations", "null_refit_invocations", "real_change_f1", "null_mean",
    "null_p95", "null_p99", "empirical_p", "null_scores",
    "null_label_vector_sha256s", "analysis_input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "cas.board_change_v2.claim2_refit_permutation.v1"},
    "claim_status": {"const": "NOT_CLAIM_ELIGIBLE_UNTIL_SEALED_LABEL_GATE0_BINDING"},
    "algorithm": {"const": "WITHIN_CONVERSATION_BLOCK_PERMUTATION_REFIT_EVERY_TRIAL"},
    "learner_id": {"const": "P1_BN_LOGISTIC_C1_LOCO_V2"},
    "learner_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "outer_split", "logistic_C", "random_state", "refit_on_every_permuted_outcome"],
      "properties": {
        "features": {"const": ["b_N"]},
        "outer_split": {"const": "leave-one-conversation-out"},
        "logistic_C": {"const": 1.0},
        "random_state": {"const": 42},
        "refit_on_every_permuted_outcome": {"const": true}
      }
    },
    "trials": {"const": 1000},
    "seed": {"const": 0},
    "learner_invocations": {"const": 1001},
    "null_refit_invocations": {"const": 1000},
    "real_change_f1": {"type": "number", "minimum": 0, "maximum": 1},
    "null_mean": {"type": "number", "minimum": 0, "maximum": 1},
    "null_p95": {"type": "number", "minimum": 0, "maximum": 1},
    "null_p99": {"type": "number", "minimum": 0, "maximum": 1},
    "empirical_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "null_scores": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "null_label_vector_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "analysis_input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "x-semantic-invariants": [
    "learner_invocations equals trials + 1",
    "null_refit_invocations equals trials",
    "null_scores and null_label_vector_sha256s each contain exactly trials entries"
  ]
}
