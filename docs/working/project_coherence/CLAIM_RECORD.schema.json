{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.example/schemas/project-coherence/claim-record.v0.1.json",
  "title": "Project Coherence empirical or product claim record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "statement_kind",
    "claim_text",
    "source_refs",
    "scope",
    "controls",
    "falsifier",
    "uncertainty",
    "evidence_packets",
    "review_state",
    "product_claim_status",
    "admission_ring",
    "disclosure_status",
    "reviewers"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^CLM-[A-Z0-9][A-Z0-9._-]*$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "statement_kind": {"enum": ["EMPIRICAL_HYPOTHESIS", "PRODUCT_CLAIM"]},
    "claim_text": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "models", "architectures", "contexts", "time_window"],
      "properties": {
        "population": {"type": "string"},
        "models": {"type": "array", "items": {"type": "string"}},
        "architectures": {"type": "array", "items": {"type": "string"}},
        "contexts": {"type": "array", "items": {"type": "string"}},
        "time_window": {"type": "string"}
      }
    },
    "controls": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "falsifier": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string", "minLength": 1},
    "evidence_packets": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review_state": {"enum": ["UNASSESSED", "IN_REVIEW", "REVIEWED"]},
    "product_claim_status": {"enum": ["LICENSED", "NOT LICENSED", "OPEN"]},
    "admission_ring": {"enum": [3, 4]},
    "disclosure_status": {"enum": ["OPEN", "HELD", "FLAG_FOR_HUMAN_REVIEW"]},
    "theorem_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reviewers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "last_reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"product_claim_status": {"const": "LICENSED"}}},
      "then": {
        "properties": {
          "review_state": {"const": "REVIEWED"},
          "admission_ring": {"const": 3},
          "evidence_packets": {"minItems": 1},
          "reviewers": {"minItems": 1}
        },
        "required": ["last_reviewed_at"]
      }
    }
  ]
}
