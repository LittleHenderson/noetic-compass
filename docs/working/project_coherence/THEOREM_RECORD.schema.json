{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.example/schemas/project-coherence/theorem-record.v0.1.json",
  "title": "Project Coherence theorem record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "statement_kind",
    "statement",
    "source_refs",
    "object_types",
    "assumptions",
    "dependencies",
    "review_state",
    "migration_disposition",
    "proof_status",
    "novelty_status",
    "admission_ring",
    "claim_boundary",
    "proof_artifacts",
    "reviewers"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^THM-[A-Z0-9][A-Z0-9._-]*$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "statement_kind": {
      "enum": ["AXIOM", "DEFINITION", "THEOREM", "PROPOSITION", "LEMMA", "COROLLARY", "CONJECTURE", "MODEL"]
    },
    "statement": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "object_types": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review_state": {"enum": ["UNASSESSED", "IN_REVIEW", "REVIEWED"]},
    "migration_disposition": {
      "enum": ["UNASSESSED", "IN_REVIEW", "INHERITED", "CLARIFIED", "CORRECTED", "CONDITIONAL", "DOWNGRADED", "DEPRECATED", "REFUTED", "REPLACED"]
    },
    "proof_status": {
      "enum": ["NOT_APPLICABLE", "PROOF_REQUIRED", "PROOF_GAP", "INFORMAL_PROOF_PRESENT", "PROVED", "FORMALLY_VERIFIED", "STANDARD_RESULT_CITED", "COUNTEREXAMPLE_PRESENT", "INDEPENDENT_REPLICATION_REQUIRED"]
    },
    "novelty_status": {
      "enum": ["STANDARD_RESULT", "STANDARD_SPECIALIZATION", "FRAMEWORK_COUPLING", "CANDIDATE_NEW_RESULT", "NOVELTY_UNASSESSED"]
    },
    "admission_ring": {"enum": [1, 2, 3, 4]},
    "claim_boundary": {"type": "string", "minLength": 1},
    "proof_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "counterexample_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reviewers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "last_reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"proof_status": {"const": "FORMALLY_VERIFIED"}}},
      "then": {"properties": {"proof_artifacts": {"minItems": 1}, "review_state": {"const": "REVIEWED"}}}
    },
    {
      "if": {"properties": {"admission_ring": {"enum": [1, 2]}}},
      "then": {"properties": {"review_state": {"const": "REVIEWED"}}, "required": ["last_reviewed_at"]}
    }
  ]
}
