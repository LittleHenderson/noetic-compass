\contentsline {figure}{\numberline {2.1}{\ignorespaces The ten Noetics. Three involution pairs, each Noetic facing its opposite, and four self-duals that invert to themselves.}}{42}{figure.2.1}%
\addvspace {10pt}
\contentsline {figure}{\numberline {3.1}{\ignorespaces Domain Descent. Causation flows downward through the precedence order; experience returns as signal along the feedback path.}}{62}{figure.3.1}%
\addvspace {10pt}
\contentsline {figure}{\numberline {4.1}{\ignorespaces The seven Core Drives in inversion pairs, with F4 Connection self-dual at the centre.}}{73}{figure.4.1}%
\addvspace {10pt}
\contentsline {figure}{\numberline {5.1}{\ignorespaces The Recursive Prerequisite Model. Desire, then Wisdom, then Power --- each stage gated by the one before it.}}{89}{figure.5.1}%
\addvspace {10pt}
\contentsline {figure}{\numberline {6.1}{\ignorespaces The seven Inversion Axes. Compound inversion is not a seventh kind but the simultaneous firing of several.}}{107}{figure.6.1}%
