\contentsline {figure}{\numberline {9.1}{\ignorespaces The forty Cognitive States: ten Noetics by four Processing Domains.}}{191}{figure.9.1}%
\contentsline {figure}{\numberline {9.2}{\ignorespaces A 40-State Heatmap. Activation is a distribution across the matrix, not a single occupied cell.}}{214}{figure.9.2}%
