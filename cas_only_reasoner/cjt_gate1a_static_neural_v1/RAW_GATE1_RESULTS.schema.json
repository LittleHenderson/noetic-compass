{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAW_GATE1_RESULTS -- the strict evidence format the status program accepts",
  "description": "Owner audit 2026-08-31 section 4: the status authority must reject malformed or contradictory evidence, not just fire branches on well-formed evidence. tools/emit_gate1_status.py enforces every constraint here with its own dependency-free validator (this schema file is the normative document; the program is the executable law). Any violation is STATUS_INPUT_INVALID -- no status is emitted from bad evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_chain", "protected_passage_ids", "arms", "claim_a", "surface_baselines"],
  "properties": {
    "schema": {"const": "RAW_GATE1_RESULTS_v2"},
    "evidence_chain": {
      "type": "object", "additionalProperties": false,
      "description": "GATE 1A.2 section 10: raw results are BOUND to the complete evidence chain, and the status program validates this block (formats, key sets, receipt-file digests under --evidence-root) BEFORE reading any accuracy or correctness vector. A well-shaped but unbound result file never receives a scientific status. The two receipts that must exist before the results are serialized (campaign_receipt_sha256, protected_evaluation_receipt_sha256) bind the PRE-receipts written before the raw results; the FINAL sealed campaign receipt then binds the results and status (no circular hash).",
      "required": ["package_commit_sha", "execution_approval_sha256", "owner_key_id",
                   "container_prep_receipt_sha256", "model_revision_sha",
                   "model_weight_manifest_sha256", "tokenizer_manifest_sha256",
                   "container_image_digest", "dependency_lock_sha256",
                   "dataset_manifest_sha256", "s7_control_table_sha256",
                   "run_schedule_sha256", "selected_layer_receipt_sha256",
                   "cache_manifest_sha256s", "checkpoint_sha256s",
                   "job_receipt_sha256s", "protected_campaign_id",
                   "protected_lock_receipt_sha256",
                   "protected_evaluation_receipt_sha256",
                   "surface_baseline_receipt_sha256", "campaign_receipt_sha256"],
      "properties": {
        "package_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "execution_approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "owner_key_id": {"type": "string", "minLength": 4},
        "container_prep_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_revision_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "model_weight_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tokenizer_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "container_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dataset_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "s7_control_table_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selected_layer_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cache_manifest_sha256s": {"type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "checkpoint_sha256s": {"type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "description": "keys must be exactly {arm}_seed{seed} for every scheduled arm/seed"},
        "job_receipt_sha256s": {"type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "protected_campaign_id": {"type": "string", "minLength": 1},
        "protected_lock_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "protected_evaluation_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "surface_baseline_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "campaign_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "protected_passage_ids": {
      "type": "array", "minItems": 1000, "maxItems": 1000,
      "items": {"type": "string", "pattern": "^p[0-9]{6}$"},
      "description": "EXACTLY 1000 ids, unique, in the frozen generation order (p000000..p000999 ascending); the validator checks uniqueness and order, which JSON Schema alone cannot"
    },
    "arms": {
      "type": "object", "additionalProperties": false,
      "required": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7"],
      "properties": {
        "S0": {"$ref": "#/$defs/arm"}, "S1": {"$ref": "#/$defs/arm"},
        "S2": {"$ref": "#/$defs/arm"}, "S3": {"$ref": "#/$defs/arm"},
        "S4": {"$ref": "#/$defs/arm"}, "S5": {"$ref": "#/$defs/arm"},
        "S6": {"$ref": "#/$defs/arm"}, "S7": {"$ref": "#/$defs/arm"}
      }
    },
    "claim_a": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_protected_accuracy", "shuffled_control_accuracy"],
      "properties": {
        "probe_protected_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "shuffled_control_accuracy": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "description": "finite fractions only; the validator rejects NaN/inf, which JSON cannot carry but a hand-built dict could"
    },
    "surface_baselines": {
      "type": "object", "additionalProperties": false,
      "required": ["train", "val", "protected"],
      "properties": {
        "train": {"$ref": "#/$defs/split_baselines"},
        "val": {"$ref": "#/$defs/split_baselines"},
        "protected": {"$ref": "#/$defs/split_baselines"}
      },
      "description": "B0 (class-blind floor) and B1 (full surface parser, the task ceiling) per split -- the status program CONSUMES these (near-ceiling labeling + mandatory ceiling disclosure), it does not merely mention them"
    }
  },
  "$defs": {
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": ["per_seed_correct", "passage_order_digest"],
      "properties": {
        "per_seed_correct": {
          "type": "object", "additionalProperties": false,
          "required": ["11", "23", "47"],
          "properties": {
            "11": {"$ref": "#/$defs/correct_vector"},
            "23": {"$ref": "#/$defs/correct_vector"},
            "47": {"$ref": "#/$defs/correct_vector"}
          }
        },
        "passage_order_digest": {
          "type": "string", "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the canonical JSON id list; must be IDENTICAL across all 8 arms and equal the digest of protected_passage_ids -- proves every arm scored the same passages in the same order"
        }
      }
    },
    "correct_vector": {
      "type": "array", "minItems": 1000, "maxItems": 1000,
      "items": {"type": "integer", "enum": [0, 1]},
      "description": "exactly 1000 entries, each exactly integer 0 or 1 (the validator rejects booleans and floats)"
    },
    "split_baselines": {
      "type": "object", "additionalProperties": false,
      "required": ["B0", "B1"],
      "properties": {
        "B0": {"$ref": "#/$defs/baseline_result"},
        "B1": {"$ref": "#/$defs/baseline_result"}
      }
    },
    "baseline_result": {
      "type": "object", "additionalProperties": false,
      "required": ["overall", "correct", "total", "per_question_type"],
      "properties": {
        "overall": {"type": "number", "minimum": 0, "maximum": 1},
        "correct": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "per_question_type": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["accuracy", "correct", "total"],
            "properties": {
              "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
              "correct": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
