{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAW_GATE1_RESULTS -- the strict evidence format the status program accepts",
  "description": "Owner audit 2026-08-31 section 4: the status authority must reject malformed or contradictory evidence, not just fire branches on well-formed evidence. tools/emit_gate1_status.py enforces every constraint here with its own dependency-free validator (this schema file is the normative document; the program is the executable law). Any violation is STATUS_INPUT_INVALID -- no status is emitted from bad evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protected_passage_ids", "arms", "claim_a", "surface_baselines"],
  "properties": {
    "schema": {"const": "RAW_GATE1_RESULTS_v1"},
    "protected_passage_ids": {
      "type": "array", "minItems": 1000, "maxItems": 1000,
      "items": {"type": "string", "pattern": "^p[0-9]{6}$"},
      "description": "EXACTLY 1000 ids, unique, in the frozen generation order (p000000..p000999 ascending); the validator checks uniqueness and order, which JSON Schema alone cannot"
    },
    "arms": {
      "type": "object", "additionalProperties": false,
      "required": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7"],
      "properties": {
        "S0": {"$ref": "#/$defs/arm"}, "S1": {"$ref": "#/$defs/arm"},
        "S2": {"$ref": "#/$defs/arm"}, "S3": {"$ref": "#/$defs/arm"},
        "S4": {"$ref": "#/$defs/arm"}, "S5": {"$ref": "#/$defs/arm"},
        "S6": {"$ref": "#/$defs/arm"}, "S7": {"$ref": "#/$defs/arm"}
      }
    },
    "claim_a": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_protected_accuracy", "shuffled_control_accuracy"],
      "properties": {
        "probe_protected_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "shuffled_control_accuracy": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "description": "finite fractions only; the validator rejects NaN/inf, which JSON cannot carry but a hand-built dict could"
    },
    "surface_baselines": {
      "type": "object", "additionalProperties": false,
      "required": ["train", "val", "protected"],
      "properties": {
        "train": {"$ref": "#/$defs/split_baselines"},
        "val": {"$ref": "#/$defs/split_baselines"},
        "protected": {"$ref": "#/$defs/split_baselines"}
      },
      "description": "B0 (class-blind floor) and B1 (full surface parser, the task ceiling) per split -- the status program CONSUMES these (near-ceiling labeling + mandatory ceiling disclosure), it does not merely mention them"
    }
  },
  "$defs": {
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": ["per_seed_correct", "passage_order_digest"],
      "properties": {
        "per_seed_correct": {
          "type": "object", "additionalProperties": false,
          "required": ["11", "23", "47"],
          "properties": {
            "11": {"$ref": "#/$defs/correct_vector"},
            "23": {"$ref": "#/$defs/correct_vector"},
            "47": {"$ref": "#/$defs/correct_vector"}
          }
        },
        "passage_order_digest": {
          "type": "string", "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the canonical JSON id list; must be IDENTICAL across all 8 arms and equal the digest of protected_passage_ids -- proves every arm scored the same passages in the same order"
        }
      }
    },
    "correct_vector": {
      "type": "array", "minItems": 1000, "maxItems": 1000,
      "items": {"type": "integer", "enum": [0, 1]},
      "description": "exactly 1000 entries, each exactly integer 0 or 1 (the validator rejects booleans and floats)"
    },
    "split_baselines": {
      "type": "object", "additionalProperties": false,
      "required": ["B0", "B1"],
      "properties": {
        "B0": {"$ref": "#/$defs/baseline_result"},
        "B1": {"$ref": "#/$defs/baseline_result"}
      }
    },
    "baseline_result": {
      "type": "object", "additionalProperties": false,
      "required": ["overall", "correct", "total", "per_question_type"],
      "properties": {
        "overall": {"type": "number", "minimum": 0, "maximum": 1},
        "correct": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "per_question_type": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["accuracy", "correct", "total"],
            "properties": {
              "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
              "correct": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
