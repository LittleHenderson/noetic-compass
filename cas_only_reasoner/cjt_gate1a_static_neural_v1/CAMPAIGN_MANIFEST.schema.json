{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAMPAIGN_MANIFEST -- the sealed record of one campaign",
  "description": "Written by the campaign driver at seal time (state RESULTS_SEALED onward). Binds the whole campaign: the transition chain digest, every phase receipt digest, the detached approval digests, and the final status. The transition log itself is the append-only JSONL of CAMPAIGN_TRANSITION records; this manifest summarizes and seals it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "mode", "package_commit_sha", "final_state",
               "transition_count", "transition_chain_sha256",
               "container_prep_approval_sha256", "execution_approval_sha256",
               "owner_key_id", "container_prep_receipt_sha256",
               "run_schedule_sha256", "selected_layer_receipt_sha256",
               "job_receipt_sha256s", "protected_lock_receipt_sha256",
               "protected_evaluation_receipt_sha256", "raw_results_sha256",
               "status_sha256", "cost_report_sha256", "campaign_receipt_sha256"],
  "properties": {
    "campaign_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["REAL", "SYNTHETIC_CONFORMANCE"]},
    "package_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "final_state": {"$ref": "CAMPAIGN_STATE.schema.json"},
    "transition_count": {"type": "integer", "minimum": 1},
    "transition_chain_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "container_prep_approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the DETACHED signed prep-approval file (never committed into the source tree it authorizes)"},
    "execution_approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner_key_id": {"type": "string", "minLength": 1},
    "container_prep_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_schedule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_layer_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "job_receipt_sha256s": {"type": "object", "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "protected_lock_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protected_evaluation_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_results_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cost_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaign_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
