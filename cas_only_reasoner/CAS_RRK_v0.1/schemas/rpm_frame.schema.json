{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpm_frame.schema.json",
  "title": "RPMFrame",
  "type": "object",
  "required": [
    "goal_id",
    "parent_goal_id",
    "kind",
    "desired_outcome",
    "requirements",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "goal_id": {
      "type": "string"
    },
    "parent_goal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "question",
        "plan",
        "subgoal"
      ]
    },
    "desired_outcome": {
      "$ref": "proposition.schema.json"
    },
    "requirements": {
      "type": "object",
      "properties": {
        "knowledge": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capability": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "RESOLVED",
        "FAILED"
      ]
    }
  }
}
