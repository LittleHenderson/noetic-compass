{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rule.schema.json",
  "title": "Rule",
  "type": "object",
  "required": [
    "rule_id",
    "premises",
    "conclusion",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "premises": {
      "type": "array",
      "items": {
        "$ref": "proposition.schema.json"
      }
    },
    "conclusion": {
      "$ref": "proposition.schema.json"
    },
    "source": {
      "type": "string"
    }
  }
}
