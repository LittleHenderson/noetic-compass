     return picked, dropped
 
 
+def pass_rank(constants):
+    """The place of each pass name in outside_services.gemini_question_writer.passes: p1 before p2 before p3."""
+    return {name: index for index, name in enumerate(constants['outside_services']['gemini_question_writer']['passes'])}
+
+
+def lowest_pass_first(constants, survivors):
+    """Plan v1.1, Step 6: per passage and form, keep the surviving candidate of the lowest pass; log the others.
+
+    Returns (kept candidates, dropped rows). The writer never learns which pass was kept; this is a fixed rule,
+    applied before the pair rule, never a choice made after seeing the solvers.
+    """
+    rank = pass_rank(constants)
+    groups = {}
+    for c in survivors:
+        if c.get('pass') not in rank:
+            raise Stop('CANDIDATE_PASS_UNKNOWN', 'Candidate %s carries the pass %r, which is not in the plan constants.' % (c['question_id'], c.get('pass')))
+        groups.setdefault((c['passage_id'], c['form']), []).append(c)
+    kept, dropped = [], []
+    for key in sorted(groups):
+        ordered = sorted(groups[key], key=lambda c: (rank[c['pass']], c['question_id']))
+        kept.append(ordered[0])
+        dropped.extend({'question_id': c['question_id'], 'reason': 'LATER_PASS_NOT_NEEDED'} for c in ordered[1:])
+    return kept, dropped
+
