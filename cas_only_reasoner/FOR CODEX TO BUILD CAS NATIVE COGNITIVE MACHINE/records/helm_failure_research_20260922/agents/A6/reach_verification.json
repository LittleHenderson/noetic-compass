          "text": "}"
        },
        {
          "number": 35,
          "text": "_ARGUMENTS = {"
        },
        {
          "number": 36,
          "text": "    \"role_set\": {\"focal_excerpt\"}, \"definition\": set(), \"context\": set(),"
        },
        {
          "number": 37,
          "text": "    \"analogy\": set(), \"correspondence\": {\"target_world_id\"},"
        },
        {
          "number": 38,
          "text": "    \"parts\": {\"whole\"}, \"edge_account\": set(), \"reach\": {\"whole\", \"part\"},"
        },
        {
          "number": 39,
          "text": "}"
        },
        {
          "number": 40,
          "text": "_QUERY_FIELDS = {\"schema\", \"source_digest\", \"focus_world_id\", \"kind\", \"rule\","
