          "text": ""
        },
        {
          "number": 44,
          "text": "class AnswerContractError(ValueError):"
        },
        {
          "number": 45,
          "text": "    \"\"\"A public query or answer is malformed, not necessarily false.\"\"\""
        },
        {
          "number": 46,
          "text": ""
        },
        {
          "number": 47,
          "text": ""
        },
        {
          "number": 48,
          "text": "def _require(condition, reason):"
        },
        {
          "number": 49,
          "text": "    if not condition:"
        },
        {
          "number": 50,
          "text": "        raise AnswerContractError(reason)"
        },
        {
          "number": 51,
          "text": ""
        },
        {
          "number": 52,
          "text": ""
        },
        {
          "number": 53,
          "text": "def _closed(value, fields, reason):"
        },
        {
          "number": 54,
          "text": "    _require(type(value) is dict and set(value) == set(fields), reason)"
        },
        {
          "number": 55,
          "text": ""
        },
        {
          "number": 56,
          "text": ""
        },
        {
          "number": 57,
          "text": "def _json(value):"
        },
        {
          "number": 58,
          "text": "    try:"
        },
        {
          "number": 59,
          "text": "        return json.dumps(value, sort_keys=True, separators=(\",\", \":\"),"
        },
        {
          "number": 60,
          "text": "                          ensure_ascii=False, allow_nan=False).encode(\"utf-8\")"
        },
        {
          "number": 61,
          "text": "    except (TypeError, ValueError, UnicodeError, RecursionError) as exc:"
        },
        {
          "number": 62,
          "text": "        raise AnswerContractError(\"TYPED_NOT_CANONICAL_JSON\") from exc"
        },
        {
          "number": 63,
          "text": ""
        },
        {
          "number": 64,
          "text": ""
        },
        {
          "number": 65,
          "text": "def _digest(value):"
        },
        {
          "number": 66,
          "text": "    return sha256(_json(value)).hexdigest()"
        },
        {
          "number": 67,
          "text": ""
        },
        {
          "number": 68,
          "text": ""
        },
        {
          "number": 69,
          "text": "def _worlds(public):"
        },
        {
          "number": 70,
          "text": "    source.validate_public(public)"
        },
        {
          "number": 71,
          "text": "    return {world[\"world_id\"]: world for world in public[\"worlds\"]}"
        },
        {
          "number": 72,
          "text": ""
        },
        {
          "number": 73,
          "text": ""
        },
        {
          "number": 74,
          "text": "def _nodes(world):"
        },
        {
