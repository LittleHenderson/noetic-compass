        {
          "number": 129,
          "text": "def _reach(world, query):"
        },
        {
          "number": 130,
          "text": "    whole, part = query[\"arguments\"][\"whole\"], query[\"arguments\"][\"part\"]"
        },
        {
          "number": 131,
          "text": "    adjacency = _adjacency(world)"
        },
        {
          "number": 132,
          "text": "    if part in adjacency[whole]:"
        },
        {
          "number": 133,
          "text": "        return {\"state\": \"DIRECT\", \"via\": None}, {"
        },
        {
          "number": 134,
          "text": "            \"path\": [whole, part], \"selection\": \"DIRECT_EDGE_TAKES_PRECEDENCE\"}"
        },
        {
          "number": 135,
          "text": "    if query[\"rule\"] == \"first_direct_constituent_lexical_v1\":"
        },
        {
          "number": 136,
          "text": "        for first in adjacency[whole]:"
        },
        {
          "number": 137,
          "text": "            suffix, _ = _bfs(adjacency, first, part)"
        },
        {
          "number": 138,
          "text": "            if suffix is not None:"
        },
        {
          "number": 139,
          "text": "                return {\"state\": \"VIA\", \"via\": first}, {"
        },
        {
          "number": 140,
          "text": "                    \"path\": [whole] + suffix,"
        },
        {
          "number": 141,
          "text": "                    \"selection\": \"LEXICAL_FIRST_DIRECT_CONSTITUENT_WITH_A_PATH\"}"
        },
        {
          "number": 142,
          "text": "        _, visited = _bfs(adjacency, whole, part)"
        },
        {
          "number": 143,
          "text": "    else:"
        },
        {
          "number": 144,
          "text": "        _require(query[\"rule\"] == \"bfs_immediate_predecessor_lexical_v1\","
        },
        {
          "number": 145,
          "text": "                 \"TYPED_CHECKER_REACH_RULE\")"
        },
        {
          "number": 146,
          "text": "        path, visited = _bfs(adjacency, whole, part)"
        },
        {
          "number": 147,
          "text": "        if path is not None:"
        },
        {
          "number": 148,
          "text": "            return {\"state\": \"VIA\", \"via\": path[-2]}, {"
        },
        {
          "number": 149,
          "text": "                \"path\": path, \"selection\": \"LEXICAL_BFS_FIRST_PATH_IMMEDIATE_PREDECESSOR\"}"
        },
        {
          "number": 150,
          "text": "    return {\"state\": \"ABSENT\", \"via\": None}, {"
        },
        {
          "number": 151,
          "text": "        \"reachable_nodes_including_start\": visited,"
        },
        {
          "number": 152,
          "text": "        \"inventory_scope\": world[\"inventory_scope\"],"
        },
        {
          "number": 153,
          "text": "        \"selection\": \"NO_PATH_IN_COMPLETE_SUPPLIED_SNAPSHOT\"}"
        },
        {
          "number": 154,
          "text": ""
        },
        {
          "number": 155,
          "text": ""
        },
        {
          "number": 156,
          "text": "def _derive_values(public, query):"
        },
        {
          "number": 157,
          "text": "    worlds = {world[\"world_id\"]: world for world in public[\"worlds\"]}"
