{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.local/schemas/neural-cjt-contracts-0.2.json",
  "title": "CAS Neural CJT v0.2 authoritative wire contracts",
  "oneOf": [
    {"$ref": "#/$defs/tensorArtifactRef"},
    {"$ref": "#/$defs/cause"},
    {"$ref": "#/$defs/readinessAxis"},
    {"$ref": "#/$defs/readinessState"},
    {"$ref": "#/$defs/stableSubstrate"},
    {"$ref": "#/$defs/localMemory"},
    {"$ref": "#/$defs/rpmState"},
    {"$ref": "#/$defs/operatingRecord"},
    {"$ref": "#/$defs/thetaRef"},
    {"$ref": "#/$defs/governance"},
    {"$ref": "#/$defs/biasState"},
    {"$ref": "#/$defs/candidateEffect"},
    {"$ref": "#/$defs/publishedEffect"},
    {"$ref": "#/$defs/operationContract"},
    {"$ref": "#/$defs/verifierReceipt"},
    {"$ref": "#/$defs/repairFrame"},
    {"$ref": "#/$defs/repairOutcome"},
    {"$ref": "#/$defs/stateUpdateIntent"},
    {"$ref": "#/$defs/modelUpdateIntent"},
    {"$ref": "#/$defs/memoryWriteIntent"},
    {"$ref": "#/$defs/commitReceipt"},
    {"$ref": "#/$defs/phaseRecord"},
    {"$ref": "#/$defs/tickTrace"}
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uint": {"type": "integer", "minimum": 0},
    "positiveInt": {"type": "integer", "minimum": 1},
    "ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "stringArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "string"},
        {"type": "integer"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "nonEmptyJsonObject": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "causeKind": {
      "enum": [
        "TOKEN", "PROPOSITION", "IDEA", "EVENT", "ENTITY_RELATION",
        "EFFECT", "MEMORY_RESULT", "OBSERVATION", "RPM_SUBGOAL",
        "TRAINING_EXPERIENCE"
      ]
    },
    "readinessAxisName": {"enum": ["DESIRE", "WISDOM", "POWER"]},
    "readinessStatus": {"enum": ["SUFFICIENT", "INSUFFICIENT", "UNKNOWN"]},
    "operatingRegion": {
      "enum": [
        "UNASSESSED", "CUTOFF", "ACTIVE", "SATURATION", "BREAKDOWN",
        "NON_OHMIC", "UNSTABLE"
      ]
    },
    "semanticOutcome": {
      "enum": ["UNASSESSED", "INTENDED", "OPPOSITE", "OFF_AXIS", "UNKNOWN"]
    },
    "verifierDisposition": {
      "enum": ["ACCEPT", "REFUSE", "ABSTAIN", "REPAIR", "QUARANTINE", "ROLLBACK", "HALT"]
    },
    "ontologyStatus": {
      "enum": [
        "CANONICAL_ADMITTED", "EXPERIMENTAL_OPEN_SEMANTICS",
        "EXPERIMENTAL_CONFLICTED_SEMANTICS", "EXPERIMENTAL_LOCAL"
      ]
    },
    "tensorArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "artifact_id", "sha256", "dtype",
        "shape", "encoding", "byte_length"
      ],
      "properties": {
        "contract_type": {"const": "TENSOR_ARTIFACT_REF"},
        "schema_version": {"const": "cas.neural-cjt.tensor-artifact-ref/0.2"},
        "artifact_id": {"$ref": "#/$defs/nonEmptyString"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "dtype": {"$ref": "#/$defs/nonEmptyString"},
        "shape": {"type": "array", "items": {"$ref": "#/$defs/uint"}},
        "encoding": {"$ref": "#/$defs/nonEmptyString"},
        "byte_length": {"$ref": "#/$defs/positiveInt"}
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "cause_id", "tick", "cause_kind",
        "content", "source", "provenance", "time_label", "uncertainty_ppm",
        "goal_context", "entity_bindings", "relation_bindings",
        "candidate_operation_ids", "memory_refs", "originating_cjt_id",
        "originating_modality", "parent_effect_id", "content_ref"
      ],
      "properties": {
        "contract_type": {"const": "CAUSE"},
        "schema_version": {"const": "cas.neural-cjt.cause/0.2"},
        "cause_id": {"$ref": "#/$defs/nonEmptyString"},
        "tick": {"$ref": "#/$defs/uint"},
        "cause_kind": {"$ref": "#/$defs/causeKind"},
        "content": {"$ref": "#/$defs/nonEmptyJsonObject"},
        "source": {"$ref": "#/$defs/nonEmptyString"},
        "provenance": {"$ref": "#/$defs/nonEmptyStringArray"},
        "time_label": {"$ref": "#/$defs/nonEmptyString"},
        "uncertainty_ppm": {"$ref": "#/$defs/ppm"},
        "goal_context": {"$ref": "#/$defs/nonEmptyJsonObject"},
        "entity_bindings": {"$ref": "#/$defs/stringArray"},
        "relation_bindings": {"$ref": "#/$defs/stringArray"},
        "candidate_operation_ids": {"$ref": "#/$defs/stringArray"},
        "memory_refs": {"$ref": "#/$defs/stringArray"},
        "originating_cjt_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonEmptyString"}]},
        "originating_modality": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonEmptyString"}]},
        "parent_effect_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonEmptyString"}]},
        "content_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tensorArtifactRef"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"cause_kind": {"const": "EFFECT"}}, "required": ["cause_kind"]},
          "then": {"properties": {"parent_effect_id": {"$ref": "#/$defs/nonEmptyString"}}}
        }
      ]
    },
    "readinessAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "axis", "status", "score_ppm",
        "threshold_ppm", "reason_codes", "evidence_refs", "provenance"
      ],
      "properties": {
        "contract_type": {"const": "READINESS_AXIS"},
        "schema_version": {"const": "cas.neural-cjt.readiness-axis/0.2"},
        "axis": {"$ref": "#/$defs/readinessAxisName"},
        "status": {"$ref": "#/$defs/readinessStatus"},
        "score_ppm": {"$ref": "#/$defs/ppm"},
        "threshold_ppm": {"$ref": "#/$defs/ppm"},
        "reason_codes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "evidence_refs": {"$ref": "#/$defs/stringArray"},
        "provenance": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "readinessState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "schema_version", "profile_id", "desire", "wisdom", "power"],
      "properties": {
        "contract_type": {"const": "READINESS_STATE"},
        "schema_version": {"const": "cas.neural-cjt.readiness-state/0.2"},
        "profile_id": {"$ref": "#/$defs/nonEmptyString"},
        "desire": {"allOf": [{"$ref": "#/$defs/readinessAxis"}, {"properties": {"axis": {"const": "DESIRE"}}}]},
        "wisdom": {"allOf": [{"$ref": "#/$defs/readinessAxis"}, {"properties": {"axis": {"const": "WISDOM"}}}]},
        "power": {"allOf": [{"$ref": "#/$defs/readinessAxis"}, {"properties": {"axis": {"const": "POWER"}}}]}
      }
    },
    "stableSubstrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "cjt_id", "formation_version",
        "registered_operation_id", "specialization_tags", "lineage_refs",
        "configuration_digest"
      ],
      "properties": {
        "contract_type": {"const": "BIAS_STABLE_SUBSTRATE"},
        "schema_version": {"const": "cas.neural-cjt.bias-stable-substrate/0.2"},
        "cjt_id": {"$ref": "#/$defs/nonEmptyString"},
        "formation_version": {"$ref": "#/$defs/uint"},
        "registered_operation_id": {"$ref": "#/$defs/nonEmptyString"},
        "specialization_tags": {"$ref": "#/$defs/stringArray"},
        "lineage_refs": {"$ref": "#/$defs/stringArray"},
        "configuration_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "localMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "recurrent_state_ref",
        "recent_cause_ids", "recent_candidate_effect_ids", "verifier_receipt_ids",
        "repair_frame_ids", "retrieved_memory_refs", "provenance_refs"
      ],
      "properties": {
        "contract_type": {"const": "BIAS_LOCAL_MEMORY"},
        "schema_version": {"const": "cas.neural-cjt.bias-local-memory/0.2"},
        "recurrent_state_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tensorArtifactRef"}]},
        "recent_cause_ids": {"$ref": "#/$defs/stringArray"},
        "recent_candidate_effect_ids": {"$ref": "#/$defs/stringArray"},
        "verifier_receipt_ids": {"$ref": "#/$defs/stringArray"},
        "repair_frame_ids": {"$ref": "#/$defs/stringArray"},
        "retrieved_memory_refs": {"$ref": "#/$defs/stringArray"},
        "provenance_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "rpmState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "readiness", "unmet_prerequisites",
        "open_repair_ids", "suspended_parent_cause_id", "return_addresses",
        "repair_history"
      ],
      "properties": {
        "contract_type": {"const": "BIAS_RPM_STATE"},
        "schema_version": {"const": "cas.neural-cjt.bias-rpm-state/0.2"},
        "readiness": {"$ref": "#/$defs/readinessState"},
        "unmet_prerequisites": {"$ref": "#/$defs/stringArray"},
        "open_repair_ids": {"$ref": "#/$defs/stringArray"},
        "suspended_parent_cause_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonEmptyString"}]},
        "return_addresses": {"$ref": "#/$defs/stringArray"},
        "repair_history": {"$ref": "#/$defs/stringArray"}
      }
    },
    "operatingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "region", "stability_status",
        "response_model_status", "semantic_outcome",
        "previous_committed_verifier_receipt_id", "last_tick"
      ],
      "properties": {
        "contract_type": {"const": "BIAS_OPERATING_RECORD"},
        "schema_version": {"const": "cas.neural-cjt.bias-operating-record/0.2"},
        "region": {"$ref": "#/$defs/operatingRegion"},
        "stability_status": {"$ref": "#/$defs/nonEmptyString"},
        "response_model_status": {"$ref": "#/$defs/nonEmptyString"},
        "semantic_outcome": {"$ref": "#/$defs/semanticOutcome"},
        "previous_committed_verifier_receipt_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonEmptyString"}]},
        "last_tick": {"$ref": "#/$defs/uint"}
      }
    },
    "thetaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "model_id", "model_version",
        "model_digest", "parameter_artifacts", "parameter_group_ids",
        "beta_microunits", "operating_profile_id", "adapter_ids"
      ],
      "properties": {
        "contract_type": {"const": "BIAS_THETA_REF"},
        "schema_version": {"const": "cas.neural-cjt.bias-theta-ref/0.2"},
        "model_id": {"$ref": "#/$defs/nonEmptyString"},
        "model_version": {"$ref": "#/$defs/uint"},
        "model_digest": {"$ref": "#/$defs/sha256"},
        "parameter_artifacts": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tensorArtifactRef"}
        },
        "parameter_group_ids": {"$ref": "#/$defs/nonEmptyStringArray"},
        "beta_microunits": {"$ref": "#/$defs/uint"},
        "operating_profile_id": {"$ref": "#/$defs/nonEmptyString"},
        "adapter_ids": {"$ref": "#/$defs/stringArray"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "hard_permissions",
        "topology_permissions", "learning_permissions", "compute_ceiling_units",
        "quarantined", "state_write_authorities", "memory_write_authorities",
        "effect_publication_authorities", "owner_restrictions"
      ],
      "properties": {
        "contract_type": {"const": "BIAS_GOVERNANCE"},
        "schema_version": {"const": "cas.neural-cjt.bias-governance/0.2"},
        "hard_permissions": {"$ref": "#/$defs/stringArray"},
        "topology_permissions": {"$ref": "#/$defs/stringArray"},
        "learning_permissions": {"$ref": "#/$defs/stringArray"},
        "compute_ceiling_units": {"$ref": "#/$defs/uint"},
        "quarantined": {"type": "boolean"},
        "state_write_authorities": {"$ref": "#/$defs/stringArray"},
        "memory_write_authorities": {"$ref": "#/$defs/stringArray"},
        "effect_publication_authorities": {"$ref": "#/$defs/stringArray"},
        "owner_restrictions": {"$ref": "#/$defs/stringArray"}
      }
    },
    "biasState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "bias_id", "cjt_id", "version",
        "previous_digest", "stable", "memory", "rpm", "operating", "theta",
        "governance", "state_digest"
      ],
      "properties": {
        "contract_type": {"const": "BIAS_STATE"},
        "schema_version": {"const": "cas.neural-cjt.bias-state/0.2"},
        "bias_id": {"$ref": "#/$defs/nonEmptyString"},
        "cjt_id": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/uint"},
        "previous_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "stable": {"$ref": "#/$defs/stableSubstrate"},
        "memory": {"$ref": "#/$defs/localMemory"},
        "rpm": {"$ref": "#/$defs/rpmState"},
        "operating": {"$ref": "#/$defs/operatingRecord"},
        "theta": {"$ref": "#/$defs/thetaRef"},
        "governance": {"$ref": "#/$defs/governance"},
        "state_digest": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"version": {"const": 0}}, "required": ["version"]},
          "then": {"properties": {"previous_digest": {"type": "null"}}},
          "else": {"properties": {"previous_digest": {"$ref": "#/$defs/sha256"}}}
        }
      ]
    },
    "candidateEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "candidate_effect_id", "tick",
        "parent_cause_id", "producer_cjt_id", "operation_id",
        "operation_contract_id", "operation_contract_digest", "bias_id",
        "bias_version", "bias_digest", "model_digest", "content", "content_ref",
        "uncertainty_ppm", "provenance", "candidate_digest", "authoritative"
      ],
      "properties": {
        "contract_type": {"const": "CANDIDATE_EFFECT"},
        "schema_version": {"const": "cas.neural-cjt.candidate-effect/0.2"},
        "candidate_effect_id": {"$ref": "#/$defs/nonEmptyString"},
        "tick": {"$ref": "#/$defs/uint"},
        "parent_cause_id": {"$ref": "#/$defs/nonEmptyString"},
        "producer_cjt_id": {"$ref": "#/$defs/nonEmptyString"},
        "operation_id": {"$ref": "#/$defs/nonEmptyString"},
        "operation_contract_id": {"$ref": "#/$defs/nonEmptyString"},
        "operation_contract_digest": {"$ref": "#/$defs/sha256"},
        "bias_id": {"$ref": "#/$defs/nonEmptyString"},
        "bias_version": {"$ref": "#/$defs/uint"},
        "bias_digest": {"$ref": "#/$defs/sha256"},
        "model_digest": {"$ref": "#/$defs/sha256"},
        "content": {"$ref": "#/$defs/nonEmptyJsonObject"},
        "content_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tensorArtifactRef"}]},
        "uncertainty_ppm": {"$ref": "#/$defs/ppm"},
        "provenance": {"$ref": "#/$defs/nonEmptyStringArray"},
        "candidate_digest": {"$ref": "#/$defs/sha256"},
        "authoritative": {"const": false}
      }
    },
    "publishedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "published_effect_id",
        "candidate_effect_id", "tick", "producer_cjt_id", "content", "content_ref",
        "verifier_receipt_id", "commit_receipt_id", "provenance",
        "publication_digest", "authoritative"
      ],
      "properties": {
        "contract_type": {"const": "PUBLISHED_EFFECT"},
        "schema_version": {"const": "cas.neural-cjt.published-effect/0.2"},
        "published_effect_id": {"$ref": "#/$defs/nonEmptyString"},
        "candidate_effect_id": {"$ref": "#/$defs/nonEmptyString"},
        "tick": {"$ref": "#/$defs/uint"},
        "producer_cjt_id": {"$ref": "#/$defs/nonEmptyString"},
        "content": {"$ref": "#/$defs/nonEmptyJsonObject"},
        "content_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tensorArtifactRef"}]},
        "verifier_receipt_id": {"$ref": "#/$defs/nonEmptyString"},
        "commit_receipt_id": {"$ref": "#/$defs/nonEmptyString"},
        "provenance": {"$ref": "#/$defs/nonEmptyStringArray"},
        "publication_digest": {"$ref": "#/$defs/sha256"},
        "authoritative": {"const": true}
      }
    },
    "operationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "contract_id", "contract_version",
        "operation_id", "operation_name", "ontology_status",
        "accepted_cause_kinds", "accepted_schema_versions",
        "permitted_evidence_ports", "neural_transform_id", "effect_schema_id",
        "memory_interface", "readiness_profile_id", "legal_actions",
        "legal_bias_paths", "temporal_transition_law", "verifier_id",
        "verifier_version", "verifier_digest", "plasticity_groups", "governance_requirements",
        "contract_digest"
      ],
      "properties": {
        "contract_type": {"const": "OPERATION_CONTRACT"},
        "schema_version": {"const": "cas.neural-cjt.operation-contract/0.2"},
        "contract_id": {"$ref": "#/$defs/nonEmptyString"},
        "contract_version": {"$ref": "#/$defs/positiveInt"},
        "operation_id": {"$ref": "#/$defs/nonEmptyString"},
        "operation_name": {"$ref": "#/$defs/nonEmptyString"},
        "ontology_status": {"$ref": "#/$defs/ontologyStatus"},
        "accepted_cause_kinds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/causeKind"}
        },
        "accepted_schema_versions": {"$ref": "#/$defs/nonEmptyStringArray"},
        "permitted_evidence_ports": {"$ref": "#/$defs/nonEmptyStringArray"},
        "neural_transform_id": {"$ref": "#/$defs/nonEmptyString"},
        "effect_schema_id": {"$ref": "#/$defs/nonEmptyString"},
        "memory_interface": {"$ref": "#/$defs/nonEmptyStringArray"},
        "readiness_profile_id": {"$ref": "#/$defs/nonEmptyString"},
        "legal_actions": {"$ref": "#/$defs/nonEmptyStringArray"},
        "legal_bias_paths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/(memory|rpm|operating|theta)(/|$)"}
        },
        "temporal_transition_law": {"$ref": "#/$defs/nonEmptyString"},
        "verifier_id": {"$ref": "#/$defs/nonEmptyString"},
        "verifier_version": {"$ref": "#/$defs/positiveInt"},
        "verifier_digest": {"$ref": "#/$defs/sha256"},
        "plasticity_groups": {"$ref": "#/$defs/nonEmptyStringArray"},
        "governance_requirements": {"$ref": "#/$defs/nonEmptyStringArray"},
        "contract_digest": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"operation_id": {"const": "^6"}}, "required": ["operation_id"]},
          "then": {"properties": {"operation_name": {"const": "decompose"}, "ontology_status": {"const": "CANONICAL_ADMITTED"}}}
        },
        {
          "if": {"properties": {"operation_id": {"const": "^2"}}, "required": ["operation_id"]},
          "then": {"properties": {"operation_name": {"const": "experimental_attract"}, "ontology_status": {"const": "EXPERIMENTAL_OPEN_SEMANTICS"}}}
        },
        {
          "if": {"properties": {"operation_id": {"const": "^3"}}, "required": ["operation_id"]},
          "then": {"properties": {"operation_name": {"const": "experimental_avert"}, "ontology_status": {"const": "EXPERIMENTAL_OPEN_SEMANTICS"}}}
        },
        {
          "if": {"properties": {"operation_id": {"const": "^8"}}, "required": ["operation_id"]},
          "then": {"properties": {"operation_name": {"const": "experimental_trigger"}, "ontology_status": {"const": "EXPERIMENTAL_CONFLICTED_SEMANTICS"}}}
        },
        {
          "if": {"properties": {"ontology_status": {"const": "CANONICAL_ADMITTED"}}, "required": ["ontology_status"]},
          "then": {"properties": {"operation_id": {"const": "^6"}}},
          "else": {"properties": {"operation_name": {"pattern": "^experimental_"}}}
        }
      ]
    },
    "verifierReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_type", "schema_version", "receipt_id", "tick", "verifier_id",
        "verifier_version", "verifier_digest", "independent", "cause_id", "candidate_effect_id",
        "candidate_effect_digest", "bias_id", "bias_version", "bias_digest",
        "operation_contract_id", "operation_contract_digest", "model_digest",
        "semantic_outcome", "disposition", "reason_codes", "evidence_refs",
        "repair_required", "receipt_digest"
      ],
      "properties": {
        "contract_type": {"const": "VERIFIER_RECEIPT"},
        "schema_version": {"const": "cas.neural-cjt.verifier-receipt/0.2"},
        "receipt_id": {"$ref": "#/$defs/nonEmptyString"},
        "tick": {"$ref": "#/$defs/uint"},
        "verifier_id": {"$ref": "#/$defs/nonEmptyString"},
        "verifier_version": {"$ref": "#/$defs/positiveInt"},
        "verifier_digest": {"$ref": "#/$defs/sha256"},
        "independent": {"const": true},
        "cause_id": {"$ref": "#/$defs/nonEmptyString"},
        "candidate_effect_id": {"$ref": "#/$defs/nonEmptyString"},
        "candidate_effect_digest": {"$ref": "#/$defs/sha256"},
        "bias_id": {"$ref": "#/$defs/nonEmptyString"},
        "bias_version": {"$ref": "#/$defs/uint"},
        "bias_digest": {"$ref": "#/$defs/sha256"},
        "operation_contract_id": {"$ref": "#/$defs/nonEmptyString"},
        "operation_contract_digest": {"$ref": "#/$defs/sha256"},
        "model_digest": {"$ref": "#/$defs/sha256"},
        "semantic_outcome": {"$ref": "#/$defs/semanticOutcome"},
