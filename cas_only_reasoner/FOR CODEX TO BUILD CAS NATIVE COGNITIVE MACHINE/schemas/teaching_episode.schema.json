{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.local/schemas/teaching_episode.schema.json",
  "title": "CCB-T1 TeachingEpisode v0.1",
  "description": "A domain-neutral, proposal-only lesson and examination plan. It cannot prove, promote, execute, write, or mutate anything.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "lesson_id",
    "episode_version_id",
    "parent_version_ids",
    "rollback_pointer",
    "lifecycle_state",
    "domain",
    "transfer_channel",
    "destination",
    "teacher_role_assignment_refs",
    "specialized_artifact_refs",
    "proposed_content",
    "prerequisites",
    "claimed_scope",
    "known_exceptions",
    "claimed_epistemic_label",
    "world_knowledge_protocol",
    "tool_use_protocol",
    "evidence_plan",
    "protected_policy",
    "pre_learning_observations",
    "post_learning_measurement_plan",
    "provenance",
    "authority_boundary",
    "package_status"
  ],
  "properties": {
    "schema_version": { "const": "cas.teaching_episode/0.1" },
    "episode_id": { "$ref": "#/$defs/identifier" },
    "lesson_id": { "$ref": "#/$defs/identifier" },
    "episode_version_id": { "$ref": "#/$defs/identifier" },
    "parent_version_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true, "maxItems": 8 },
    "rollback_pointer": { "oneOf": [{ "$ref": "#/$defs/artifactReference" }, { "type": "null" }] },
    "lifecycle_state": { "$ref": "#/$defs/lifecycleState" },
    "domain": { "$ref": "#/$defs/domain" },
    "transfer_channel": { "$ref": "#/$defs/channel" },
    "destination": { "$ref": "#/$defs/destination" },
    "teacher_role_assignment_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/teacherAssignmentReference" },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 64
    },
    "specialized_artifact_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/specializedArtifactReference" },
      "uniqueItems": true,
      "maxItems": 256
    },
    "proposed_content": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposedContent" },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 4096
    },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "#/$defs/prerequisite" },
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 4096
    },
    "claimed_scope": { "$ref": "#/$defs/claimedScope" },
    "known_exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/knownException" },
      "uniqueItems": true,
      "maxItems": 4096
    },
    "claimed_epistemic_label": {
      "type": "string",
      "enum": ["PROPOSED", "HYPOTHETICAL", "IMAGINED", "SOURCE_ASSERTED", "UNKNOWN"]
    },
    "world_knowledge_protocol": { "oneOf": [{ "$ref": "#/$defs/worldKnowledgeProtocol" }, { "type": "null" }] },
    "tool_use_protocol": { "oneOf": [{ "$ref": "#/$defs/toolUseProtocol" }, { "type": "null" }] },
    "evidence_plan": { "$ref": "#/$defs/evidencePlan" },
    "protected_policy": { "$ref": "#/$defs/protectedPolicy" },
    "pre_learning_observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/casOhmObservationRef" },
      "uniqueItems": true,
      "maxItems": 128
    },
    "post_learning_measurement_plan": { "$ref": "#/$defs/measurementPlan" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "authority_boundary": { "$ref": "#/$defs/authorityBoundary" },
    "package_status": { "$ref": "#/$defs/packageStatus" }
  },
  "allOf": [
    {
      "if": { "properties": { "transfer_channel": { "const": "CCB_T1_CHANNEL_EXPLICIT_SYMBOLIC" } }, "required": ["transfer_channel"] },
      "then": {
        "properties": {
          "destination": {
            "enum": ["CCB_T1_DEST_CAS_SEM_CONCEPT_CANDIDATE", "CCB_T1_DEST_PROCEDURAL_RECIPE_CANDIDATE", "CCB_T1_DEST_LANGUAGE_CONSTRUCTION_CANDIDATE", "CCB_T1_DEST_CCDL_BOARD_CANDIDATE", "CCB_T1_DEST_PROTECTED_REVIEW_ONLY"]
          }
        }
      }
    },
    {
      "if": { "properties": { "transfer_channel": { "const": "CCB_T1_CHANNEL_DEMONSTRATION_PROCEDURAL_INDUCTION" } }, "required": ["transfer_channel"] },
      "then": {
        "properties": {
          "destination": {
            "enum": ["CCB_T1_DEST_PROCEDURAL_RECIPE_CANDIDATE", "CCB_T1_DEST_DIALOGUE_PROCEDURE_CANDIDATE", "CCB_T1_DEST_STRATEGY_BOARD_CANDIDATE", "CCB_T1_DEST_PROTECTED_REVIEW_ONLY"]
          }
        }
      }
    },
    {
      "if": { "properties": { "transfer_channel": { "const": "CCB_T1_CHANNEL_NEURAL_DISTILLATION" } }, "required": ["transfer_channel"] },
      "then": { "properties": { "destination": { "enum": ["CCB_T1_DEST_REPLACEABLE_NEURAL_PROPOSAL_SUBBOARD_CANDIDATE", "CCB_T1_DEST_PROTECTED_REVIEW_ONLY"] } } }
    },
    {
      "if": { "properties": { "transfer_channel": { "const": "CCB_T1_CHANNEL_RETRIEVAL_LINKED_KNOWLEDGE" } }, "required": ["transfer_channel"] },
      "then": { "properties": { "destination": { "enum": ["CCB_T1_DEST_SOURCE_LINKED_RETRIEVAL_RECORD_CANDIDATE", "CCB_T1_DEST_PROTECTED_REVIEW_ONLY"] } } }
    },
    {
      "if": { "properties": { "transfer_channel": { "const": "CCB_T1_CHANNEL_SYNTHETIC_EXPERIENCE" } }, "required": ["transfer_channel"] },
      "then": { "properties": { "destination": { "enum": ["CCB_T1_DEST_CAS_SDG_CURRICULUM_CANDIDATE", "CCB_T1_DEST_EPISODIC_TRAINING_RECORD_CANDIDATE", "CCB_T1_DEST_PERCEPTION_GROUNDING_CURRICULUM_CANDIDATE", "CCB_T1_DEST_PROTECTED_REVIEW_ONLY"] } } }
    },
    {
      "if": { "properties": { "domain": { "const": "CCB_T1_DOMAIN_WORLD_KNOWLEDGE" } }, "required": ["domain"] },
      "then": { "properties": { "world_knowledge_protocol": { "$ref": "#/$defs/worldKnowledgeProtocol" } } },
      "else": { "properties": { "world_knowledge_protocol": { "type": "null" } } }
    },
    {
      "if": { "properties": { "domain": { "const": "CCB_T1_DOMAIN_TOOL_USE" } }, "required": ["domain"] },
      "then": { "properties": { "tool_use_protocol": { "$ref": "#/$defs/toolUseProtocol" } } },
      "else": { "properties": { "tool_use_protocol": { "type": "null" } } }
    },
    {
      "if": { "properties": { "domain": { "const": "CCB_T1_DOMAIN_CREATIVITY" } }, "required": ["domain"] },
      "then": { "properties": { "claimed_epistemic_label": { "enum": ["HYPOTHETICAL", "IMAGINED"] } } }
    },
    {
      "if": { "properties": { "protected_policy": { "properties": { "protected_category": { "not": { "const": "CCB_T1_PROTECTED_NONE" } } }, "required": ["protected_category"] } }, "required": ["protected_policy"] },
      "then": {
        "properties": {
          "destination": { "const": "CCB_T1_DEST_PROTECTED_REVIEW_ONLY" },
          "protected_policy": {
            "properties": {
              "protected_non_autonomous": { "const": true },
              "autonomous_promotion_allowed": { "const": false },
              "separately_governed_review_route": { "$ref": "#/$defs/reviewRoute" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "protected_policy": {
            "properties": {
              "protected_non_autonomous": { "const": false },
              "autonomous_promotion_allowed": { "const": false },
              "separately_governed_review_route": { "type": "null" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$",
      "maxLength": 256
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "CCB_T1_EPISODE_PROPOSED",
        "CCB_T1_EPISODE_SCHEMA_VALID",
        "CCB_T1_EPISODE_PREREQUISITES_SATISFIED",
        "CCB_T1_EPISODE_DEVELOPMENT_EVIDENCE_PASS",
        "CCB_T1_EPISODE_PROTECTED_HELD_OUT_PASS",
        "CCB_T1_EPISODE_REGRESSION_PASS",
        "CCB_T1_EPISODE_PROVISIONAL_PROMOTION_RECOMMENDED",
        "CCB_T1_EPISODE_DELAYED_RETENTION_PASS",
        "CCB_T1_EPISODE_DURABLE_PROMOTION_RECOMMENDED",
        "CCB_T1_EPISODE_QUARANTINED",
        "CCB_T1_EPISODE_SUPERSEDED",
        "CCB_T1_EPISODE_ROLLBACK_RECOMMENDED"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "CCB_T1_DOMAIN_LANGUAGE", "CCB_T1_DOMAIN_WORLD_KNOWLEDGE", "CCB_T1_DOMAIN_REASONING_STRATEGY", "CCB_T1_DOMAIN_MATHEMATICS", "CCB_T1_DOMAIN_SOFTWARE_ENGINEERING", "CCB_T1_DOMAIN_TOOL_USE", "CCB_T1_DOMAIN_RESEARCH_METHOD", "CCB_T1_DOMAIN_MEMORY_ORGANIZATION", "CCB_T1_DOMAIN_METACOGNITION", "CCB_T1_DOMAIN_SOCIAL_CONVERSATION", "CCB_T1_DOMAIN_CREATIVITY", "CCB_T1_DOMAIN_BOARD_DESIGN", "CCB_T1_DOMAIN_SELF_DIAGNOSIS", "CCB_T1_DOMAIN_MULTIMODAL_PERCEPTION"
      ]
    },
    "channel": {
      "type": "string",
      "enum": ["CCB_T1_CHANNEL_EXPLICIT_SYMBOLIC", "CCB_T1_CHANNEL_DEMONSTRATION_PROCEDURAL_INDUCTION", "CCB_T1_CHANNEL_NEURAL_DISTILLATION", "CCB_T1_CHANNEL_RETRIEVAL_LINKED_KNOWLEDGE", "CCB_T1_CHANNEL_SYNTHETIC_EXPERIENCE"]
    },
    "destination": {
      "type": "string",
      "enum": ["CCB_T1_DEST_CAS_SEM_CONCEPT_CANDIDATE", "CCB_T1_DEST_SOURCE_LINKED_RETRIEVAL_RECORD_CANDIDATE", "CCB_T1_DEST_PROCEDURAL_RECIPE_CANDIDATE", "CCB_T1_DEST_LANGUAGE_CONSTRUCTION_CANDIDATE", "CCB_T1_DEST_DIALOGUE_PROCEDURE_CANDIDATE", "CCB_T1_DEST_STRATEGY_BOARD_CANDIDATE", "CCB_T1_DEST_CCDL_BOARD_CANDIDATE", "CCB_T1_DEST_REPLACEABLE_NEURAL_PROPOSAL_SUBBOARD_CANDIDATE", "CCB_T1_DEST_CAS_SDG_CURRICULUM_CANDIDATE", "CCB_T1_DEST_EPISODIC_TRAINING_RECORD_CANDIDATE", "CCB_T1_DEST_PERCEPTION_GROUNDING_CURRICULUM_CANDIDATE", "CCB_T1_DEST_PROTECTED_REVIEW_ONLY"]
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "artifact_digest"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "artifact_type": { "$ref": "#/$defs/identifier" },
        "artifact_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "teacherAssignmentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "assignment_version", "assignment_digest", "schema_id"],
      "properties": {
        "assignment_id": { "$ref": "#/$defs/identifier" },
        "assignment_version": { "$ref": "#/$defs/identifier" },
        "assignment_digest": { "$ref": "#/$defs/digest" },
        "schema_id": { "const": "https://cas.local/schemas/teacher_role_assignment.schema.json" }
      }
    },
    "specializedArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_digest", "schema_id", "must_validate"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "schema_id": {
          "type": "string",
          "enum": [
            "https://cas.local/schemas/language_lesson_packet.schema.json",
            "https://cas.local/schemas/grammar_construction.schema.json",
            "https://cas.local/schemas/semantic_frame.schema.json",
            "https://cas.local/schemas/language_qualification_receipt.schema.json",
            "https://cas.local/schemas/math_evidence_packet.schema.json",
            "https://cas.local/schemas/cas_ohm_stage_record.schema.json"
          ]
        },
        "must_validate": { "const": true }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "source_digest", "retrieved_at", "validity_window_id"],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "source_type": { "type": "string", "enum": ["TEACHER_PROPOSAL", "DOCUMENT", "DATABASE", "TOOL_RESULT", "HUMAN_ANCHOR", "EXPERIMENT", "SENSOR_RECORD", "SPECIALIZED_ARTIFACT"] },
        "source_digest": { "$ref": "#/$defs/digest" },
        "retrieved_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "validity_window_id": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] }
      }
    },
    "proposedContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "content_type", "summary", "content_digest", "epistemic_label", "source_refs", "teacher_confidence_basis_points", "executable_payload_present"],
      "properties": {
        "content_id": { "$ref": "#/$defs/identifier" },
        "content_type": {
          "type": "string",
          "enum": ["CLAIM", "DEFINITION", "PROCEDURE", "REASONING_STRATEGY", "PROOF_METHOD", "TOOL_CONTRACT", "RESEARCH_METHOD", "MEMORY_METHOD", "DIALOGUE_PROCEDURE", "CREATIVE_METHOD", "BOARD_DESIGN", "REPAIR_PATTERN", "NEURAL_TRAINING_OBJECTIVE", "PERCEPTION_GROUNDING_CURRICULUM"]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "content_digest": { "$ref": "#/$defs/digest" },
        "epistemic_label": { "type": "string", "enum": ["PROPOSED", "HYPOTHETICAL", "IMAGINED", "SOURCE_ASSERTED", "UNKNOWN"] },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" }, "minItems": 1, "uniqueItems": true, "maxItems": 256 },
        "teacher_confidence_basis_points": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "executable_payload_present": { "const": false }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prerequisite_id", "prerequisite_type", "required", "resolution_status", "evidence_requirement_digest", "evidence_receipt_ref", "resolver_class", "teacher_can_waive"],
      "properties": {
        "prerequisite_id": { "$ref": "#/$defs/identifier" },
        "prerequisite_type": { "type": "string", "enum": ["KNOWLEDGE", "PROCEDURE", "LANGUAGE", "MATHEMATICS", "TOOL_CAPABILITY", "PERMISSION", "GROUNDING", "EVIDENCE", "CONSTITUTIONAL_AUTHORIZATION", "OTHER_DECLARED"] },
        "required": { "type": "boolean" },
        "resolution_status": { "type": "string", "enum": ["CCB_T1_PREREQ_UNASSESSED", "CCB_T1_PREREQ_MISSING", "CCB_T1_PREREQ_EVIDENCE_BOUND", "CCB_T1_PREREQ_NOT_APPLICABLE_BY_FROZEN_PROFILE"] },
        "evidence_requirement_digest": { "$ref": "#/$defs/digest" },
        "evidence_receipt_ref": { "oneOf": [{ "$ref": "#/$defs/artifactReference" }, { "type": "null" }] },
        "resolver_class": { "type": "string", "enum": ["EXISTING_QUALIFIED_ARTIFACT", "PROPOSED_CHILD_LESSON", "HUMAN_AUTHORIZATION", "EXTERNAL_GROUNDED_EVIDENCE", "FROZEN_PROFILE_NOT_APPLICABLE"] },
        "teacher_can_waive": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "resolution_status": { "const": "CCB_T1_PREREQ_EVIDENCE_BOUND" } }, "required": ["resolution_status"] },
          "then": { "properties": { "evidence_receipt_ref": { "$ref": "#/$defs/artifactReference" } } }
        },
        {
          "if": { "properties": { "resolution_status": { "enum": ["CCB_T1_PREREQ_UNASSESSED", "CCB_T1_PREREQ_MISSING"] } }, "required": ["resolution_status"] },
          "then": { "properties": { "evidence_receipt_ref": { "type": "null" } } }
        }
      ]
    },
    "claimedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ids", "domain_partition_ids", "included_capabilities", "excluded_capabilities", "validity_window_id", "open_ended_claim"],
      "properties": {
        "profile_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "minItems": 1, "uniqueItems": true, "maxItems": 128 },
        "domain_partition_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "minItems": 1, "uniqueItems": true, "maxItems": 128 },
        "included_capabilities": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "minItems": 1, "uniqueItems": true, "maxItems": 512 },
        "excluded_capabilities": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true, "maxItems": 512 },
        "validity_window_id": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "open_ended_claim": { "const": false }
      }
    },
    "knownException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exception_id", "summary", "exception_digest", "handling"],
      "properties": {
        "exception_id": { "$ref": "#/$defs/identifier" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "exception_digest": { "$ref": "#/$defs/digest" },
        "handling": { "type": "string", "enum": ["REJECT", "CLARIFY", "ABSTAIN", "ROUTE_TO_SPECIALIST", "REQUIRE_EXTERNAL_EVIDENCE"] }
      }
    },
    "worldKnowledgeProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporal_class", "valid_from", "valid_until", "retrieval_time", "source_refs", "contradictory_source_refs", "verification_method", "teacher_memory_only_sufficient"],
      "properties": {
        "temporal_class": { "type": "string", "enum": ["STABLE", "MUTABLE", "CURRENT_ONLY", "HISTORICAL_AS_OF"] },
        "valid_from": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "valid_until": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "retrieval_time": { "type": "string", "format": "date-time" },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" }, "minItems": 1, "uniqueItems": true, "maxItems": 256 },
        "contradictory_source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" }, "uniqueItems": true, "maxItems": 256 },
        "verification_method": { "type": "string", "enum": ["TRUSTED_DOCUMENT_CORROBORATION", "TRUSTED_DATABASE_CORROBORATION", "CURRENT_RETRIEVAL_CROSS_CHECK", "HUMAN_ANCHORED_REVIEW"] },
        "teacher_memory_only_sufficient": { "const": false }
      }
    },
    "toolUseProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_class_id", "appropriateness_rule_digest", "input_schema_digest", "output_schema_digest", "permission_requirement_digest", "result_verification_digest", "failure_modes_digest", "executes_tool", "grants_permission"],
      "properties": {
        "tool_class_id": { "$ref": "#/$defs/identifier" },
        "appropriateness_rule_digest": { "$ref": "#/$defs/digest" },
        "input_schema_digest": { "$ref": "#/$defs/digest" },
        "output_schema_digest": { "$ref": "#/$defs/digest" },
        "permission_requirement_digest": { "$ref": "#/$defs/digest" },
        "result_verification_digest": { "$ref": "#/$defs/digest" },
        "failure_modes_digest": { "$ref": "#/$defs/digest" },
        "executes_tool": { "const": false },
        "grants_permission": { "const": false }
      }
    },
    "partitionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition_id", "partition_kind", "custodian_id", "custodian_role", "generator_id", "generator_digest", "manifest_digest", "seed_ids", "seed_partition_digest", "planned_case_count", "visibility", "execution_status", "teacher_involved_in_generation", "teacher_has_access_before_seal", "teacher_can_grade"],
      "properties": {
        "partition_id": { "$ref": "#/$defs/identifier" },
        "partition_kind": { "type": "string", "enum": ["DEVELOPMENT", "PROTECTED_HELD_OUT", "FROZEN_REGRESSION", "DELAYED_RETENTION"] },
        "custodian_id": { "$ref": "#/$defs/identifier" },
        "custodian_role": { "type": "string", "enum": ["CCB_T1_DEVELOPMENT_CUSTODIAN", "CCB_T1_PROTECTED_HELD_OUT_CUSTODIAN", "CCB_T1_FROZEN_REGRESSION_CUSTODIAN", "CCB_T1_DELAYED_RETENTION_CUSTODIAN"] },
        "generator_id": { "$ref": "#/$defs/identifier" },
        "generator_digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "seed_ids": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "uniqueItems": true, "maxItems": 100000 },
        "seed_partition_digest": { "$ref": "#/$defs/digest" },
        "planned_case_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "visibility": { "type": "string", "enum": ["DEVELOPMENT_VISIBLE", "WITHHELD_FROM_TEACHER", "FROZEN_CONFIGURATION", "DELAYED_WITHHELD"] },
        "execution_status": { "const": "CCB_T1_PARTITION_PLANNED" },
        "teacher_involved_in_generation": { "const": false },
        "teacher_has_access_before_seal": { "const": false },
        "teacher_can_grade": { "const": false }
      }
    },
    "frozenVerifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_id", "verifier_class", "verifier_revision", "verifier_artifact_digest", "configuration_digest", "custodian_id", "custodian_role", "frozen", "frozen_before_protected_run", "teacher_can_modify", "teacher_can_grade", "promotion_authority"],
      "properties": {
        "verifier_id": { "$ref": "#/$defs/identifier" },
        "verifier_class": { "type": "string", "enum": ["SEMANTIC_FRAME_COMPARER", "SOURCE_CORROBORATION_VERIFIER", "TRACE_STRATEGY_COMPARER", "EXACT_MATH_CHECKER", "PROOF_VERIFIER", "ISOLATED_CODE_TEST_HARNESS", "TOOL_PERMISSION_AND_OUTPUT_VERIFIER", "REGISTERED_RESEARCH_DESIGN_REVIEW", "MEMORY_RETENTION_VERIFIER", "CALIBRATION_VERIFIER", "DIALOGUE_CONSTRAINT_VERIFIER", "CREATIVE_CONSTRAINT_AND_LABEL_VERIFIER", "BOARD_COMPILER_DRC_SIMULATOR", "DESCENDANT_FAULT_VERIFIER", "MULTIMODAL_GROUNDING_VERIFIER", "INDEPENDENT_HUMAN_ANCHORED_REVIEW"] },
        "verifier_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "verifier_artifact_digest": { "$ref": "#/$defs/digest" },
        "configuration_digest": { "$ref": "#/$defs/digest" },
        "custodian_id": { "$ref": "#/$defs/identifier" },
        "custodian_role": { "const": "CCB_T1_FROZEN_VERIFIER_CUSTODIAN" },
        "frozen": { "const": true },
        "frozen_before_protected_run": { "const": true },
        "teacher_can_modify": { "const": false },
        "teacher_can_grade": { "const": false },
        "promotion_authority": { "const": false }
      }
    },
    "evidencePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_example_manifest_digest", "contrast_manifest_digest", "negative_example_manifest_digest", "counterexample_manifest_digest", "independent_anchor_refs", "development", "protected_held_out", "frozen_regression", "delayed_retention", "frozen_verifier", "deterministic_replay_plan_digest", "development_and_protected_seeds_disjoint", "teacher_excluded_from_protected_custody", "teacher_excluded_from_verifier_custody", "verifier_frozen_before_protected_run", "custody_separated"],
      "properties": {
        "positive_example_manifest_digest": { "$ref": "#/$defs/digest" },
        "contrast_manifest_digest": { "$ref": "#/$defs/digest" },
        "negative_example_manifest_digest": { "$ref": "#/$defs/digest" },
        "counterexample_manifest_digest": { "$ref": "#/$defs/digest" },
        "independent_anchor_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" }, "minItems": 1, "uniqueItems": true, "maxItems": 256 },
        "development": { "allOf": [{ "$ref": "#/$defs/partitionPlan" }, { "properties": { "partition_kind": { "const": "DEVELOPMENT" }, "custodian_role": { "const": "CCB_T1_DEVELOPMENT_CUSTODIAN" }, "visibility": { "const": "DEVELOPMENT_VISIBLE" } } }] },
        "protected_held_out": { "allOf": [{ "$ref": "#/$defs/partitionPlan" }, { "properties": { "partition_kind": { "const": "PROTECTED_HELD_OUT" }, "custodian_role": { "const": "CCB_T1_PROTECTED_HELD_OUT_CUSTODIAN" }, "visibility": { "const": "WITHHELD_FROM_TEACHER" } } }] },
        "frozen_regression": { "allOf": [{ "$ref": "#/$defs/partitionPlan" }, { "properties": { "partition_kind": { "const": "FROZEN_REGRESSION" }, "custodian_role": { "const": "CCB_T1_FROZEN_REGRESSION_CUSTODIAN" }, "visibility": { "const": "FROZEN_CONFIGURATION" } } }] },
        "delayed_retention": { "allOf": [{ "$ref": "#/$defs/partitionPlan" }, { "properties": { "partition_kind": { "const": "DELAYED_RETENTION" }, "custodian_role": { "const": "CCB_T1_DELAYED_RETENTION_CUSTODIAN" }, "visibility": { "const": "DELAYED_WITHHELD" } } }] },
        "frozen_verifier": { "$ref": "#/$defs/frozenVerifier" },
        "deterministic_replay_plan_digest": { "$ref": "#/$defs/digest" },
        "development_and_protected_seeds_disjoint": { "const": true },
        "teacher_excluded_from_protected_custody": { "const": true },
        "teacher_excluded_from_verifier_custody": { "const": true },
        "verifier_frozen_before_protected_run": { "const": true },
        "custody_separated": { "const": true }
      }
    },
    "protectedPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected_category", "protected_non_autonomous", "autonomous_promotion_allowed", "separately_governed_review_route"],
      "properties": {
        "protected_category": { "type": "string", "enum": ["CCB_T1_PROTECTED_NONE", "CCB_T1_PROTECTED_AUTHORITY_CONTRACT", "CCB_T1_PROTECTED_SOLE_WRITER_RULE", "CCB_T1_PROTECTED_PROOF_CHECKER", "CCB_T1_PROTECTED_TRACE_VERIFIER", "CCB_T1_PROTECTED_BENCHMARKS", "CCB_T1_PROTECTED_CONSTITUTIONAL_VALUES", "CCB_T1_PROTECTED_DEPLOYMENT_PERMISSIONS", "CCB_T1_PROTECTED_ROLLBACK_MACHINERY", "CCB_T1_PROTECTED_DEFINITION_OF_IMPROVEMENT"] },
        "protected_non_autonomous": { "type": "boolean" },
        "autonomous_promotion_allowed": { "const": false },
        "separately_governed_review_route": { "oneOf": [{ "$ref": "#/$defs/reviewRoute" }, { "type": "null" }] }
      }
    },
    "reviewRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "governing_contract_id", "governing_contract_digest", "human_authorization_required", "ccb_t1_can_authorize"],
      "properties": {
        "route_id": { "$ref": "#/$defs/identifier" },
        "governing_contract_id": { "$ref": "#/$defs/identifier" },
        "governing_contract_digest": { "$ref": "#/$defs/digest" },
        "human_authorization_required": { "const": true },
        "ccb_t1_can_authorize": { "const": false }
      }
    },
    "casOhmObservationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_digest", "schema_id", "use", "correctness_authority", "qualification_authority", "promotion_authority", "causal_identification_authority"],
      "properties": {
        "record_id": { "$ref": "#/$defs/identifier" },
        "record_digest": { "$ref": "#/$defs/digest" },
        "schema_id": { "const": "https://cas.local/schemas/cas_ohm_stage_record.schema.json" },
        "use": { "const": "OBSERVATION_ONLY" },
        "correctness_authority": { "const": false },
        "qualification_authority": { "const": false },
        "promotion_authority": { "const": false },
        "causal_identification_authority": { "const": false }
      }
    },
    "measurementPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "metrics", "measurement_manifest_digest", "post_measurement_partition_id", "cas_ohm_observation_only", "behavioral_correctness_source"],
      "properties": {
        "plan_id": { "$ref": "#/$defs/identifier" },
        "metrics": { "type": "array", "items": { "type": "string", "enum": ["CAPABILITY_GAIN_MICRO_UNITS", "RESISTANCE_REDUCTION_MICRO_UNITS", "HELD_OUT_TRANSFER_BASIS_POINTS", "RETENTION_BASIS_POINTS", "TEACHER_DEPENDENCE_BASIS_POINTS", "TEACHING_EFFICIENCY_EXACT_RATIO", "CRITICAL_REGRESSION_COUNT", "UNAUTHORIZED_COMMIT_COUNT"] }, "minItems": 1, "uniqueItems": true, "maxItems": 8 },
        "measurement_manifest_digest": { "$ref": "#/$defs/digest" },
        "post_measurement_partition_id": { "$ref": "#/$defs/identifier" },
        "cas_ohm_observation_only": { "const": true },
        "behavioral_correctness_source": { "const": "FROZEN_VERIFIER_EVIDENCE" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_artifact_ids", "source_artifact_digests", "created_at", "canonicalization", "episode_digest"],
      "properties": {
        "source_artifact_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "minItems": 1, "uniqueItems": true, "maxItems": 512 },
        "source_artifact_digests": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "minItems": 1, "uniqueItems": true, "maxItems": 512 },
        "created_at": { "type": "string", "format": "date-time" },
        "canonicalization": { "const": "CNCM_CANONICAL_JSON_V0.1_WITHOUT_PROVENANCE_EPISODE_DIGEST" },
        "episode_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_only", "truth_authority", "meaning_authority", "proof_authority", "validity_authority", "qualification_authority", "promotion_authority", "commitment_authority", "permission_authority", "memory_write_authority", "state_mutation_authority", "halt_authority", "causal_identification_authority", "external_action_authority", "self_modification_authority", "emits_cncm_intents"],
      "properties": {
        "proposal_only": { "const": true },
        "truth_authority": { "const": false },
        "meaning_authority": { "const": false },
        "proof_authority": { "const": false },
        "validity_authority": { "const": false },
        "qualification_authority": { "const": false },
        "promotion_authority": { "const": false },
        "commitment_authority": { "const": false },
        "permission_authority": { "const": false },
        "memory_write_authority": { "const": false },
        "state_mutation_authority": { "const": false },
        "halt_authority": { "const": false },
        "causal_identification_authority": { "const": false },
        "external_action_authority": { "const": false },
        "self_modification_authority": { "const": false },
        "emits_cncm_intents": { "const": false }
      }
    },
    "packageStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_maturity", "kernel_integration_status", "runtime_effect"],
      "properties": {
        "package_maturity": { "const": "EXPERIMENTAL" },
        "kernel_integration_status": { "const": "NOT_KERNEL_INTEGRATED" },
        "runtime_effect": { "const": "NONE" }
      }
    }
  }
