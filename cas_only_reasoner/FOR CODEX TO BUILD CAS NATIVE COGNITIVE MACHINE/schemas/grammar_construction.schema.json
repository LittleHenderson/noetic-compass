{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.local/schemas/grammar_construction.schema.json",
  "title": "CCB-L1 GrammarConstruction v0.1",
  "description": "A versioned, inspectable grammar-construction candidate for the experimental CCB-L1 apprenticeship package. It is data, not executable source or kernel authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "construction_id",
    "version_id",
    "home_subboard",
    "lifecycle_state",
    "source_lesson_id",
    "surface_pattern",
    "semantic_transformation",
    "admitted_features",
    "scope",
    "exception_ids",
    "qualification_receipt_ids",
    "lineage_id",
    "cas_ohm_observation_refs",
    "provenance",
    "authority_boundary",
    "package_status"
  ],
  "properties": {
    "schema_version": { "const": "cas.grammar_construction/0.1" },
    "construction_id": { "$ref": "#/$defs/identifier" },
    "version_id": { "$ref": "#/$defs/identifier" },
    "home_subboard": { "const": "CCB-L1-GRAM" },
    "lifecycle_state": { "$ref": "#/$defs/lifecycleState" },
    "source_lesson_id": { "$ref": "#/$defs/identifier" },
    "surface_pattern": { "$ref": "#/$defs/surfacePattern" },
    "semantic_transformation": { "$ref": "#/$defs/semanticTransformation" },
    "admitted_features": { "$ref": "#/$defs/admittedFeatures" },
    "scope": { "$ref": "#/$defs/constructionScope" },
    "exception_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true,
      "maxItems": 512
    },
    "qualification_receipt_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true,
      "maxItems": 512
    },
    "lineage_id": { "$ref": "#/$defs/identifier" },
    "cas_ohm_observation_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/casOhmObservationRef" },
      "uniqueItems": true,
      "maxItems": 128
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "authority_boundary": { "$ref": "#/$defs/authorityBoundary" },
    "package_status": { "$ref": "#/$defs/packageStatus" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$",
      "maxLength": 256
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "CCB_L1_GRAM_PROPOSED",
        "CCB_L1_GRAM_SCHEMA_VALID",
        "CCB_L1_GRAM_COMPILED",
        "CCB_L1_GRAM_POSITIVE_EXAMPLES_PASS",
        "CCB_L1_GRAM_CONTRAST_TESTS_PASS",
        "CCB_L1_GRAM_HELD_OUT_GENERALIZATION_PASS",
        "CCB_L1_GRAM_PRIOR_GRAMMAR_REGRESSION_PASS",
        "CCB_L1_GRAM_AMBIGUITY_BEHAVIOR_PASS",
        "CCB_L1_GRAM_PROMOTED_PROVISIONALLY",
        "CCB_L1_GRAM_DELAYED_RETENTION_PASS",
        "CCB_L1_GRAM_PROMOTED_DURABLY",
        "CCB_L1_GRAM_ACTIVE",
        "CCB_L1_GRAM_QUARANTINED",
        "CCB_L1_GRAM_SUPERSEDED",
        "CCB_L1_GRAM_ROLLED_BACK"
      ]
    },
    "surfaceElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "element_kind", "symbol", "category", "feature_constraints", "optional", "repeat"],
      "properties": {
        "position": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "element_kind": { "type": "string", "enum": ["CCB_L1_PATTERN_LITERAL", "CCB_L1_PATTERN_SLOT", "CCB_L1_PATTERN_BOUNDARY"] },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 256 },
        "category": {
          "type": "string",
          "enum": ["LITERAL", "NP", "VP", "VERB", "AUXILIARY", "ADJECTIVE", "ADVERB", "PREPOSITION", "DETERMINER", "PRONOUN", "CLAUSE", "PUNCTUATION", "OTHER_REGISTERED"]
        },
        "feature_constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/featureConstraint" },
          "uniqueItems": true,
          "maxItems": 64
        },
        "optional": { "type": "boolean" },
        "repeat": { "type": "string", "enum": ["EXACTLY_ONE", "ZERO_OR_ONE", "ONE_OR_MORE"] }
      }
    },
    "featureConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "operator", "value"],
      "properties": {
        "feature": {
          "type": "string",
          "enum": ["PERSON", "NUMBER", "GENDER", "CASE", "TENSE", "ASPECT", "VOICE", "POLARITY", "MOOD", "ANIMACY", "DEFINITENESS", "CATEGORY"]
        },
        "operator": { "type": "string", "enum": ["EQUALS", "NOT_EQUALS", "IN_REGISTERED_SET"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "surfacePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern_id", "pattern_language", "elements", "anchor_start", "anchor_end", "pattern_digest"],
      "properties": {
        "pattern_id": { "$ref": "#/$defs/identifier" },
        "pattern_language": { "const": "CCB_L1_PATTERN_IR/0.1" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/surfaceElement" }, "minItems": 1, "maxItems": 128 },
        "anchor_start": { "const": true },
        "anchor_end": { "const": true },
        "pattern_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "semanticVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable_id", "semantic_type", "source_symbol", "required"],
      "properties": {
        "variable_id": { "$ref": "#/$defs/identifier" },
        "semantic_type": {
          "type": "string",
          "enum": ["ENTITY", "EVENT", "PREDICATE", "PROPERTY", "TIME", "QUANTIFIER", "CLAUSE", "REFERENCE", "DISCOURSE_UNIT", "FEATURE_VALUE"]
        },
        "source_symbol": { "$ref": "#/$defs/identifier" },
        "required": { "type": "boolean" }
      }
    },
    "transformOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_index", "operation", "output_id", "input_ids", "literal_value"],
      "properties": {
        "operation_index": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "operation": {
          "type": "string",
          "enum": [
            "CCB_L1_OP_CREATE_FRAME",
            "CCB_L1_OP_CREATE_NODE",
            "CCB_L1_OP_BIND_PREDICATE",
            "CCB_L1_OP_BIND_ROLE",
            "CCB_L1_OP_SET_TENSE",
            "CCB_L1_OP_SET_ASPECT",
            "CCB_L1_OP_SET_VOICE",
            "CCB_L1_OP_SET_POLARITY",
            "CCB_L1_OP_SET_MODALITY",
            "CCB_L1_OP_SET_SENTENCE_FORCE",
            "CCB_L1_OP_BIND_QUANTIFIER",
            "CCB_L1_OP_BIND_REFERENCE",
            "CCB_L1_OP_BIND_DISCOURSE_LINK",
            "CCB_L1_OP_EMIT_ALTERNATIVE",
            "CCB_L1_OP_REQUIRE_CLARIFICATION"
          ]
        },
        "output_id": { "$ref": "#/$defs/identifier" },
        "input_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "maxItems": 32 },
        "literal_value": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 1024 },
            { "type": "integer" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        }
      }
    },
    "semanticTransformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transformation_id", "transformation_ir_version", "variables", "operations", "output_frame_id", "artifact_digest", "deterministic", "side_effect_free", "executable_source_present"],
      "properties": {
        "transformation_id": { "$ref": "#/$defs/identifier" },
        "transformation_ir_version": { "const": "CCB_L1_SEMANTIC_TRANSFORM_IR/0.1" },
        "variables": { "type": "array", "items": { "$ref": "#/$defs/semanticVariable" }, "minItems": 1, "uniqueItems": true, "maxItems": 128 },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/transformOperation" }, "minItems": 1, "maxItems": 4096 },
        "output_frame_id": { "$ref": "#/$defs/identifier" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "deterministic": { "const": true },
        "side_effect_free": { "const": true },
        "executable_source_present": { "const": false }
      }
    },
    "admittedFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "tense", "aspect", "polarity", "quantification", "reference", "clause_type", "sentence_force"],
      "properties": {
        "voice": { "type": "array", "items": { "type": "string", "enum": ["ACTIVE", "PASSIVE", "MIDDLE", "NOT_APPLICABLE"] }, "minItems": 1, "uniqueItems": true },
        "tense": { "type": "array", "items": { "type": "string", "enum": ["PAST", "PRESENT", "FUTURE", "TIMELESS", "UNSPECIFIED"] }, "minItems": 1, "uniqueItems": true },
        "aspect": { "type": "array", "items": { "type": "string", "enum": ["SIMPLE", "PROGRESSIVE", "PERFECT", "PERFECT_PROGRESSIVE", "UNSPECIFIED"] }, "minItems": 1, "uniqueItems": true },
        "polarity": { "type": "array", "items": { "type": "string", "enum": ["POSITIVE", "NEGATIVE"] }, "minItems": 1, "uniqueItems": true },
        "quantification": { "type": "array", "items": { "type": "string", "enum": ["UNIVERSAL", "EXISTENTIAL", "NEGATIVE", "DEFINITE", "INDEFINITE", "NONE"] }, "minItems": 1, "uniqueItems": true },
        "reference": { "type": "array", "items": { "type": "string", "enum": ["RESOLVED", "UNRESOLVED", "AMBIGUOUS", "NOT_APPLICABLE"] }, "minItems": 1, "uniqueItems": true },
        "clause_type": { "type": "array", "items": { "type": "string", "enum": ["MAIN", "COORDINATE", "SUBORDINATE", "RELATIVE", "CONDITIONAL", "NOT_APPLICABLE"] }, "minItems": 1, "uniqueItems": true },
        "sentence_force": { "type": "array", "items": { "type": "string", "enum": ["DECLARATIVE", "INTERROGATIVE", "IMPERATIVE", "EXCLAMATIVE"] }, "minItems": 1, "uniqueItems": true }
      }
    },
    "constructionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language_profile_ids", "domain_ids", "registered_lexical_categories", "required_construction_ids", "excluded_cases", "open_ended_claim"],
      "properties": {
        "language_profile_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "minItems": 1, "uniqueItems": true, "maxItems": 128 },
        "domain_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "minItems": 1, "uniqueItems": true, "maxItems": 128 },
        "registered_lexical_categories": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "minItems": 1, "uniqueItems": true, "maxItems": 256 },
        "required_construction_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true, "maxItems": 256 },
        "excluded_cases": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true, "maxItems": 512 },
        "open_ended_claim": { "const": false }
      }
    },
    "casOhmObservationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_digest", "use", "semantic_correctness_authority", "promotion_authority", "causal_identification_authority"],
      "properties": {
        "record_id": { "$ref": "#/$defs/identifier" },
        "record_digest": { "$ref": "#/$defs/digest" },
        "use": { "const": "OBSERVATION_ONLY" },
        "semantic_correctness_authority": { "const": false },
        "promotion_authority": { "const": false },
        "causal_identification_authority": { "const": false }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_artifact_ids", "source_artifact_digests", "created_at", "compiler_id", "compiler_revision", "compiler_digest", "canonicalization", "construction_digest"],
      "properties": {
        "source_artifact_ids": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "minItems": 1, "uniqueItems": true, "maxItems": 256 },
        "source_artifact_digests": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "minItems": 1, "uniqueItems": true, "maxItems": 256 },
        "created_at": { "type": "string", "format": "date-time" },
        "compiler_id": { "$ref": "#/$defs/identifier" },
        "compiler_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "compiler_digest": { "$ref": "#/$defs/digest" },
        "canonicalization": { "const": "CNCM_CANONICAL_JSON_V0.1_WITHOUT_PROVENANCE_CONSTRUCTION_DIGEST" },
        "construction_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_state_only", "truth_authority", "meaning_authority", "proof_authority", "promotion_authority", "commitment_authority", "permission_authority", "memory_write_authority", "state_mutation_authority", "halt_authority", "external_action_authority", "self_modification_authority", "emits_cncm_intents"],
      "properties": {
        "artifact_state_only": { "const": true },
        "truth_authority": { "const": false },
        "meaning_authority": { "const": false },
        "proof_authority": { "const": false },
        "promotion_authority": { "const": false },
        "commitment_authority": { "const": false },
        "permission_authority": { "const": false },
        "memory_write_authority": { "const": false },
        "state_mutation_authority": { "const": false },
        "halt_authority": { "const": false },
        "external_action_authority": { "const": false },
        "self_modification_authority": { "const": false },
        "emits_cncm_intents": { "const": false }
      }
    },
    "packageStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_maturity", "kernel_integration_status", "runtime_effect"],
      "properties": {
        "package_maturity": { "const": "EXPERIMENTAL" },
        "kernel_integration_status": { "const": "NOT_KERNEL_INTEGRATED" },
        "runtime_effect": { "const": "NONE" }
      }
    }
  }
}
