{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.local/schemas/proposition.schema.json",
  "title": "CNCM Proposition v0.1",
  "description": "The accepted Proposition input shape and the emitted dataclass shape. Optional fields use the runtime defaults when absent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["predicate", "arguments"],
  "properties": {
    "predicate": { "$ref": "#/$defs/identifier" },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/term_identifier" }
    },
    "polarity": { "type": "boolean", "default": true },
    "evidence_status": {
      "type": "string",
      "enum": ["asserted", "derived", "hypothetical", "contradicted", "unknown"],
      "default": "unknown"
    },
    "provenance": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenance" },
      "default": []
    },
    "scope": { "$ref": "#/$defs/identifier", "default": "global" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:\\-]*$"
    },
    "term_identifier": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        {
          "type": "string",
          "pattern": "^\\?[A-Za-z_][A-Za-z0-9_.:\\-]*$"
        }
      ]
    },
    "provenance_identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:\\-]*$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/provenance_identifier" },
        "detail": { "type": "string", "default": "" }
      }
    }
  }
}
