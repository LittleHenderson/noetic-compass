{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.local/schemas/procedure_substrate_artifact.schema.json",
  "title": "Isolated six-instruction rational candidate; no install or verification authority",
  "description": "Structural admission only. Python semantic admission additionally verifies the content digest, canonical source/program identity, integer types, and cross-field bit limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "executor_revision",
    "capability_contract",
    "claim_boundary",
    "input_names",
    "output_names",
    "revision",
    "limits",
    "provenance",
    "program",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "cncm.procedure-substrate-artifact/0.1"
    },
    "executor_revision": {
      "const": "cncm.six-instruction-rational-executor/0.1"
    },
    "capability_contract": {
      "const": "cncm.rational-two-op-candidate/0.1"
    },
    "claim_boundary": {
      "const": "SUBSTRATE_CANDIDATE_ONLY"
    },
    "input_names": {
      "const": [
        "a",
        "b",
        "c"
      ]
    },
    "output_names": {
      "const": [
        "x"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_bits",
        "intermediate_bits"
      ],
      "properties": {
        "input_bits": {
          "type": "integer",
          "minimum": 2,
          "maximum": 128
        },
        "intermediate_bits": {
          "type": "integer",
          "minimum": 2,
          "maximum": 512
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      }
    },
    "program": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "target",
            "arguments"
          ],
          "properties": {
            "operation": {
              "const": "LOAD_INPUT"
            },
            "target": {
              "const": "r0"
            },
            "arguments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
