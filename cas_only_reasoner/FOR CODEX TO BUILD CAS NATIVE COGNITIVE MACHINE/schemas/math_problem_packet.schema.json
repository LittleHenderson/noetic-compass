{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.local/schemas/math_problem_packet.schema.json",
  "title": "CAS-Math Linear Problem Packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "problem_id", "theory_id", "statement", "solve_variable", "provenance"],
  "properties": {
    "schema_version": { "const": "cncm.math-problem/0.1" },
    "problem_id": { "type": "string", "pattern": "^math-problem-[0-9a-f]{16}$" },
    "theory_id": { "const": "cncm.q-linear/0.1" },
    "statement": { "$ref": "math_statement.schema.json" },
    "solve_variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "proposition.schema.json#/$defs/provenance" } }
  }
}
