{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.local/schemas/dialogue_turn.schema.json",
  "title": "CAS DialogueTurn v0.1",
  "description": "One immutable admitted conversation turn and its state revision boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conversation_id",
    "turn_id",
    "turn_index",
    "speaker_id",
    "speaker_role",
    "input_mode",
    "raw_text",
    "normalized_text",
    "language_profile",
    "acts",
    "semantic_packet_ids",
    "state_before_revision",
    "state_after_revision",
    "processing_status",
    "trace_refs"
  ],
  "properties": {
    "schema_version": { "const": "cas.dialogue_turn/0.1" },
    "conversation_id": { "$ref": "#/$defs/identifier" },
    "turn_id": { "$ref": "#/$defs/identifier" },
    "turn_index": { "type": "integer", "minimum": 1 },
    "speaker_id": { "$ref": "#/$defs/identifier" },
    "speaker_role": { "enum": ["USER", "SYSTEM"] },
    "input_mode": { "enum": ["CONTROLLED_ENGLISH", "DIRECT_SEMANTIC"] },
    "raw_text": { "type": ["string", "null"] },
    "normalized_text": { "type": ["string", "null"] },
    "language_profile": { "enum": ["CCB-L1-CE-0.1", "NONE"] },
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "dialogue_act.schema.json" }
    },
    "semantic_packet_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "state_before_revision": { "type": "integer", "minimum": 0 },
    "state_after_revision": { "type": "integer", "minimum": 1 },
    "processing_status": {
      "enum": [
        "ACCEPTED",
        "CLARIFICATION_REQUIRED",
        "UNSUPPORTED",
        "REJECTED"
      ]
    },
    "trace_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "input_mode": { "const": "CONTROLLED_ENGLISH" } },
        "required": ["input_mode"]
      },
      "then": {
        "properties": {
          "raw_text": { "type": "string", "minLength": 1 },
          "normalized_text": { "type": "string", "minLength": 1 },
          "language_profile": { "const": "CCB-L1-CE-0.1" }
        }
      }
    },
    {
      "if": {
        "properties": { "input_mode": { "const": "DIRECT_SEMANTIC" } },
        "required": ["input_mode"]
      },
      "then": {
        "properties": {
          "raw_text": { "type": "null" },
          "normalized_text": { "type": "null" },
          "language_profile": { "const": "NONE" }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
    }
  }
}

