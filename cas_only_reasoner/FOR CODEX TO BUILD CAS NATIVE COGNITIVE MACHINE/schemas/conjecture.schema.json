{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cas.local/schemas/conjecture.schema.json",
  "title": "CAS-Math Conjecture Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["conjecture_id", "theory_id", "variables", "statement", "guards", "status", "provenance"],
  "properties": {
    "conjecture_id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:\\-]*$" },
    "theory_id": { "type": "string" },
    "variables": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
    "statement": { "$ref": "math_statement.schema.json" },
    "guards": { "type": "array", "items": { "$ref": "math_statement.schema.json" } },
    "status": { "type": "string", "enum": ["CONJECTURED", "DISPROVED", "UNKNOWN", "VERIFIED"] },
    "provenance": { "type": "array", "items": { "$ref": "proposition.schema.json#/$defs/provenance" } }
  }
}
