# Noetic Compass — Environment Configuration
# Copy this file to .env and fill in your values.
# All variables are prefixed with NC_ for namespacing.

# ─── LLM Provider API Keys ───────────────────────────────────────────
# Set the key for whichever provider(s) you want to use.
# Leave blank to disable that provider (mock mode is always available).

NC_OPENAI_API_KEY=
NC_ANTHROPIC_API_KEY=
NC_GOOGLE_API_KEY=

# Meta/Llama (OpenAI-compatible endpoint — Groq, Together, Fireworks)
NC_META_API_BASE_URL=
NC_META_API_KEY=

# xAI Grok (https://console.x.ai)
NC_XAI_API_KEY=

# DeepSeek (https://platform.deepseek.com)
NC_DEEPSEEK_API_KEY=

# Alibaba Qwen (https://dashscope.aliyun.com)
NC_QWEN_API_KEY=

# ─── JWT Authentication ──────────────────────────────────────────────
NC_JWT_SECRET=change-me-in-production

# ─── Rate Limiting ───────────────────────────────────────────────────
# Tier: community=50, professional=500, enterprise=0 (unlimited)
NC_RATE_LIMIT_RPM=60
NC_RATE_LIMIT_TIER=community

# ─── Application ─────────────────────────────────────────────────────
NC_DEBUG=false
NC_DEFAULT_LLM_PROVIDER=mock

# ─── CORS ────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * for development.
# Example: https://app.example.com,https://staging.example.com
NC_CORS_ORIGINS=*

# ─── Database (optional) ─────────────────────────────────────────────
# PostgreSQL connection URL. Leave blank if not using database.
NC_DATABASE_URL=

# --- CAS Harness Evidence Packet anchoring ---------------------------------
# Default is disabled. Set mode=s3 only after the bucket and AWS credentials
# are configured, otherwise new packets will honestly report Anchor failed.
CAS_HARNESS_EVIDENCE_ANCHOR_MODE=disabled

# For S3, bucket is the bucket name only, not s3://bucket/path.
# Put any folder-like path in CAS_HARNESS_EVIDENCE_ANCHOR_S3_PREFIX.
CAS_HARNESS_EVIDENCE_ANCHOR_S3_BUCKET=
CAS_HARNESS_EVIDENCE_ANCHOR_S3_PREFIX=cas-harness/evidence-anchors
CAS_HARNESS_EVIDENCE_ANCHOR_S3_REGION=
CAS_HARNESS_EVIDENCE_ANCHOR_S3_OBJECT_LOCK_MODE=
CAS_HARNESS_EVIDENCE_ANCHOR_S3_RETENTION_DAYS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Atlas live-trace worker (hosted open-weight audits) -------------------
# Base URL the API uses to reach the private Pythia-160M live-trace worker.
# The worker stays private on the GPU pod; the API reaches it over an SSH
# tunnel, so this points at the LOCAL end of that tunnel, not the pod directly.
# Open the tunnel first (see live-trace-worker/scripts/open_atlas_live_tunnel.sh),
# then set this to the forwarded local port. Leave blank to disable the live
# path — hosted open-weight audits then fail honestly instead of fabricating.
# Example: http://127.0.0.1:18080
ATLAS_LIVE_WORKER_URL=
# Per-request HTTP timeout (seconds) for the worker call. Default 30.
ATLAS_LIVE_HTTP_TIMEOUT_SECONDS=30

# ─── Docker Compose Database ─────────────────────────────────────────
NC_DB_USER=noetic
NC_DB_PASSWORD=noetic_dev
