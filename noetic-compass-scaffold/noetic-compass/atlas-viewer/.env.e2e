# Vite env file consumed when building with `vite build --mode e2e`.
# Enables the production-side E2E click hook in NeuralNetScene.tsx
# (the `window.__nn_e2e_click(layer, index)` that Playwright spec 4 uses).
# Default production builds (`vite build`) do NOT read this file and
# therefore do NOT ship the hook.
VITE_ENABLE_E2E_HOOK=true
