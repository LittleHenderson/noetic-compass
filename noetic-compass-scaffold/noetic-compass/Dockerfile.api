# Noetic Compass API — multi-stage build
# Stage 1: build cas-engine Rust crate via maturin
# Stage 2: lightweight Python runtime with non-root user

# --- Build stage ---
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Install build-only tools (maturin) + runtime deps
COPY requirements.txt .
RUN pip install --no-cache-dir maturin -r requirements.txt

# Build cas-engine Rust crate
COPY cas-engine/ cas-engine/
RUN cd cas-engine && maturin build --release --features python && \
    pip install --no-cache-dir target/wheels/*.whl

# --- Runtime stage ---
FROM python:3.12-slim

# Create non-root user
RUN groupadd --gid 1000 ncuser && \
    useradd --uid 1000 --gid ncuser --create-home --shell /bin/bash ncuser && \
    install -d -m 0700 -o ncuser -g ncuser /home/ncuser/.ssh

WORKDIR /app

# Install only runtime dependencies (no maturin/Rust)
COPY requirements-runtime.txt .
RUN pip install --no-cache-dir -r requirements-runtime.txt

# Copy cas-engine wheel from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages/cas_engine* /usr/local/lib/python3.12/site-packages/

# Copy application code
COPY api/ api/
COPY cas-native/ cas-native/
COPY docs/working/pythia160m_gate1/ docs/working/pythia160m_gate1/
COPY docs/working/gpt_neox_20b_stage9_original_40e_evidence_packet_20260528T0455Z.json docs/working/gpt_neox_20b_stage9_original_40e_evidence_packet_20260528T0455Z.json
COPY scenarios/ scenarios/
COPY validation/ validation/
# Operators run only these bounded, fail-closed commands from Render Shell.
# Do not copy the wider development scripts directory into production.
COPY scripts/verify_account_canary_quotas.py scripts/verify_account_canary_quotas.py
COPY scripts/collect_hosted_customer_journey_evidence.py scripts/collect_hosted_customer_journey_evidence.py
COPY scripts/collect_airtable_crm_acceptance_source.py scripts/collect_airtable_crm_acceptance_source.py
COPY scripts/publish_customer_production_acceptance_authority.py scripts/publish_customer_production_acceptance_authority.py

# Set ownership to non-root user
RUN chown -R ncuser:ncuser /app

USER ncuser

EXPOSE 8000

# Health check — uses the /health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${PORT:-8000}/health')" || exit 1

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
