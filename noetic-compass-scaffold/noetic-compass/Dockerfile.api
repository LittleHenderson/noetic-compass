# Noetic Compass API — multi-stage build
# Stage 1: build cas-engine Rust crate via maturin
# Stage 2: lightweight Python runtime with non-root user

# --- Build stage ---
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY cas-engine/ cas-engine/
RUN cd cas-engine && maturin build --release --features python && \
    pip install --no-cache-dir target/wheels/*.whl

# --- Runtime stage ---
FROM python:3.12-slim

# Create non-root user
RUN groupadd --gid 1000 ncuser && \
    useradd --uid 1000 --gid ncuser --create-home ncuser

WORKDIR /app

# Copy installed Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY api/ api/
COPY scenarios/ scenarios/
COPY validation/ validation/

# Set ownership to non-root user
RUN chown -R ncuser:ncuser /app

USER ncuser

EXPOSE 8000

# Health check — uses the /health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}
