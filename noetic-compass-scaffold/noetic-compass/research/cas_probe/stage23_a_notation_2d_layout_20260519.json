{
  "boundary": "Static canonical 2D positions for CAS primitives across Stage 23.A (Noetics/Domains/Drives/Registers/Cognitive States), Stage 23.A.2 (Operations / Inversion Axes / Foundations / Production / RPM / Set primitives / Combinators / Authority Sets / Cardinality kinds), and Stage 23.A.3 (12 admitted Omega_* emergent registers from cas-native/config/omega_registry.yaml, each anchored at radius 1.8 along its derivation Noetic's angle). Does not include atlas-self-reading, encoder design, or training signal.",
  "detection_rules": [
    {
      "description": "Omega_* name pattern",
      "kind": "emergent_omega",
      "priority": 1,
      "regex": "\\bOmega_[A-Za-z]+\\b"
    },
    {
      "description": "Greek capital omega glyph",
      "kind": "emergent_omega",
      "priority": 2,
      "regex": "Ω"
    },
    {
      "description": "Greek capital theta glyph",
      "kind": "production",
      "priority": 3,
      "regex": "Θ"
    },
    {
      "description": "Theta spelled out",
      "kind": "production",
      "priority": 4,
      "regex": "\\bTheta\\b"
    },
    {
      "description": "...Cluster suffix",
      "kind": "set_constructor",
      "priority": 5,
      "regex": "[A-Za-z]+Cluster\\b"
    },
    {
      "description": "Compound cognitive state ^N^D",
      "kind": "cognitive_state",
      "priority": 6,
      "regex": "\\^\\d\\^[PCEO](?![A-Za-z0-9])"
    },
    {
      "description": "Bare Noetic ^N",
      "kind": "noetic",
      "priority": 7,
      "regex": "\\^\\d(?![\\^\\dPCEO])"
    },
    {
      "description": "Bare Drive F1..F7",
      "kind": "drive",
      "priority": 8,
      "regex": "\\bF[1-7]\\b"
    },
    {
      "description": "Drive in subscript _{Fk}",
      "kind": "drive",
      "priority": 9,
      "regex": "_\\{F[1-7]\\}"
    },
    {
      "description": "Standalone Domain ^P/^C/^E/^O",
      "kind": "domain",
      "priority": 10,
      "regex": "\\^[PCEO]\\b"
    },
    {
      "description": "Standalone Register |T/|A/|f/|E",
      "kind": "register",
      "priority": 11,
      "regex": "\\|[TAfE]\\b"
    },
    {
      "description": "Register set marker |⟨…⟩",
      "kind": "register",
      "priority": 12,
      "regex": "\\|⟨"
    }
  ],
  "layout_version": "stage23a3_notation_2d_layout_v3",
