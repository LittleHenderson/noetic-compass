      "algorithm": {
        "name": "balanced_splitwise_label_shuffle_with_identity_repair",
        "version": "v1",
        "steps": [
          "For each frozen split separately, collect the canonical source labels as a multiset.",
          "Sort rows by stable row key.",
          "Shuffle the label multiset with numpy.random.default_rng(seed).permutation.",
          "Repair accidental identity assignments by cyclically swapping assigned labels among identity rows.",
          "If full identity repair is impossible, residual unchanged labels must be below 1 percent in that split.",
          "Emit one row-level assignment artifact per seed."
        ],
        "preserve_per_split_class_counts": true,
        "expected_result": "near_chance_hidden_readout_and_dirty_lacunarity"
      }
    },
