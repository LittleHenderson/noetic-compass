# Showcase program exercising the CAS language surface
use "CAS_SHOWCASE_MODULE.cas";

let encoded: state[C] = compose(foundation, CO-4^C_{F2});
let readiness: rpm = rpm_of(response);
let motif: fractal = weave(encoded, CO-8^C);
