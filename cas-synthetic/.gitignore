data/level2_scaffold/*
!data/level2_scaffold/.gitkeep
!data/level2_scaffold/level3_recoverable_eval_1000.jsonl
!data/level2_scaffold/level3_recoverable_eval_1000_v77_relabeled.jsonl
!data/level2_scaffold/level3_recoverable_eval_1000_metrics.json
!data/level2_scaffold/LEVEL3_RECOVERABLE_EVAL_1000_REPORT.md
data/native_nl/*.jsonl
!data/native_nl/.gitkeep
# Throughput / scratch benchmark artifacts (T8 and similar). The wildcard above
# already excludes this directory; the explicit rule below is documentation.
data/level2_scaffold/_bench/
data/pytest-tmp/
__pycache__/
*.pyc
.pytest_cache/

# --- bulk generated Path-D regeneration output (archive, don't commit) ---
# NOTE: do NOT ignore data/path_d/v1_eval_pack_* — those are the committed
# reproducibility eval packs and must stay tracked.
data/path_d/wave3_*
data/path_d/*_dryrun.jsonl
data/path_d/*_dryrun.json
data/*_tmp.jsonl
# Large built corpora (keep on disk; not committed to git)
data/level3_pilot_full.jsonl
v1_mix_nlgen_train.jsonl
tests/_tmp_*/
.pytest-tmp-level3/
test-tmp-level3/
