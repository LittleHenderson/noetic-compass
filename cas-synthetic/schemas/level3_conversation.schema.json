{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noeticcompass.com/schemas/level3_conversation.schema.json",
  "title": "CAS Synthetic Level 3 Conversational Example",
  "description": "Single-turn conversational supervision record linked to a Level 2 CAS synthetic source example.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_level2_id",
    "bucket",
    "cas_expression",
    "user_prompt",
    "natural_language_mapping",
    "assistant_response",
    "follow_up_question",
    "soft_operator_targets",
    "soft_domain_targets",
    "tags",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable Level 3 record identifier. Recommended prefix: l3conv_."
    },
    "source_level2_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable pointer to the Level 2 source example, row, hash, or derived ID."
    },
    "bucket": {
      "type": "string",
      "enum": [
        "v74_baseline",
        "v75_register",
        "v77_rule_four",
        "v77_omega",
        "v76_production",
        "meta_logic"
      ],
      "description": "Source Level 2 generator bucket."
    },
    "cas_expression": {
      "type": "string",
      "minLength": 1,
      "description": "Compiler-valid CAS expression retained as the structural target."
    },
    "user_prompt": {
      "type": "string",
      "minLength": 1,
      "description": "User-facing conversational prompt for the assistant turn."
    },
    "natural_language_mapping": {
      "type": "string",
      "minLength": 1,
      "description": "Training annotation explaining why the prompt maps to the CAS expression and soft targets."
    },
    "assistant_response": {
      "type": "string",
      "minLength": 1,
      "description": "Conversational target answer. Should avoid diagnostic, predictive, or overclaiming language."
    },
    "follow_up_question": {
      "type": "string",
      "minLength": 1,
      "description": "Open-ended conversational follow-up question."
    },
    "soft_operator_targets": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/probability"
      },
      "$comment": "Ordered by Noetic index ^0 through ^9. A validator should check that values sum to approximately 1.0."
    },
    "soft_domain_targets": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/probability"
          },
          "$comment": "Ordered as [P, C, E, O]. A validator should check that values sum to approximately 1.0."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["P", "C", "E", "O"],
          "properties": {
            "P": {
              "$ref": "#/$defs/probability"
            },
            "C": {
              "$ref": "#/$defs/probability"
            },
            "E": {
              "$ref": "#/$defs/probability"
            },
            "O": {
              "$ref": "#/$defs/probability"
            }
          },
          "$comment": "Object form over Domains P/C/E/O. A validator should check that values sum to approximately 1.0."
        }
      ],
      "description": "Soft distribution over CAS Domains."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Search/filter labels for dataset curation."
    },
    "provenance": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "level3_spec_version",
        "generation_method"
      ],
      "properties": {
        "level3_spec_version": {
          "type": "string",
          "minLength": 1
        },
        "generation_method": {
          "type": "string",
          "minLength": 1
        },
        "level2_dataset": {
          "type": "string",
          "minLength": 1
        },
        "level2_commit": {
          "type": "string",
          "minLength": 1
        },
        "level2_row_index": {
          "type": "integer",
          "minimum": 0
        },
        "level2_hash": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "description": "Traceability metadata for source, generation, and review."
    }
  },
  "$defs": {
    "probability": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
